---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile' | 'book';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  lang?: 'ru' | 'en';
  alternates?: { ru?: string; en?: string };
}
const {
  title,
  description = 'Практические материалы по фандрайзингу, гранты, курсы и тренинги для НКО и предпринимателей.',
  image = '/og-image.jpg',
  type = 'website',
  noindex = false,
  jsonLd,
  lang = 'ru',
  alternates,
} = Astro.props;
const site = Astro.site ?? new URL('https://azatisrail.org');
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, site).href;
const imageUrl = new URL(image, site).href;
const fullTitle = lang === 'en' ? `${title} — Azat Israilov` : `${title} — Азат Исраилов`;

const navRu = [['/book', 'Книга'], ['/posts', 'Блог'], ['/projects', 'Проекты'], ['/trainings', 'Тренинги'], ['/courses', 'Курсы'], ['/about', 'Обо мне']];
const navRuMobileExtra = [['/publications', 'Публикации'], ['/funding', 'Финансирование'], ['/videos', 'Видео']];
const navEn = [['#services', 'What I do'], ['#partners', 'Partners & investors'], ['#projects', 'Projects'], ['#book', 'The book'], ['#contact', 'Contact']];
const nav = lang === 'en' ? navEn : navRu;
const mobileNav = lang === 'en' ? navEn : [...navRu.slice(0, 5), ...navRuMobileExtra, navRu[5]];
const cta = lang === 'en'
  ? { href: '#contact', label: 'Get in touch', external: false, track: 'contact_nav_en' }
  : { href: 'https://t.me/connect4faq/137', label: 'Бесплатный путеводитель', external: true, track: 'guide_nav' };
const switchLang = lang === 'en' ? { href: '/', label: 'RU', title: 'Русская версия' } : { href: '/en/', label: 'EN', title: 'English version' };
const footerLinks = lang === 'en'
  ? [['Projects', 'https://azatisrail.org/#projects'], ['Fundan', 'https://fundan.cc'], ['RateKit', 'https://ratekit.org'], ['ResumeLink', 'https://resumelink.cc'], ['LinkedIn', 'https://linkedin.com/in/azat-israilov-6b515228/'], ['YouTube', 'https://www.youtube.com/@connect4fund']]
  : [['Обо мне', '/about'], ['Проекты', '/projects'], ['Публикации', '/publications'], ['Финансирование', '/funding'], ['Видео', '/videos'], ['YouTube', 'https://www.youtube.com/@connect4fund'], ['LinkedIn', 'https://linkedin.com/in/azat-israilov-6b515228/'], ['Связаться', '/contact'], ['Поддержать', '/support'], ['Fundan', 'https://fundan.cc'], ['ResumeLink', 'https://resumelink.cc']];
const footerCopy = lang === 'en' ? '© 2026 · Azat Israilov · azatisrail.org' : '© 2026 · Азат Исраилов · azatisrail.org';
const person = {
  '@type': 'Person',
  '@id': 'https://azatisrail.org/#person',
  name: 'Азат Исраилов',
  alternateName: ['Azat Israilov', 'Исраилов Азат'],
  jobTitle: 'Консультант по фандрайзингу, тренер, бизнес-консультант',
  description: 'Консультант, тренер и фандрайзер из Бишкека. 18+ лет в международном развитии, привлёк $2.3M финансирования, автор методологии «3 Дерева» и руководства «Как привлечь денежный грант».',
  url: 'https://azatisrail.org/about/',
  image: 'https://azatisrail.org/og-image.jpg',
  email: 'mailto:azat@azatisrail.org',
  telephone: '+996702271827',
  address: { '@type': 'PostalAddress', addressLocality: 'Бишкек', addressCountry: 'KG' },
  knowsLanguage: ['ru', 'ky', 'en'],
  knowsAbout: ['Фандрайзинг', 'Грантовые заявки', 'Работа с донорами', 'Стратегическое планирование НКО', 'Бизнес-консалтинг', 'Акселерация МСБ', 'Центральная Азия'],
  worksFor: { '@type': 'Organization', name: 'Connect4Pro', url: 'https://azatisrail.cc/' },
  sameAs: [
    'https://linkedin.com/in/azat-israilov-6b515228/',
    'https://www.youtube.com/@connect4fund',
    'https://azatisrail.cc/',
    'https://github.com/AIsrail',
    'https://www.facebook.com/1278314085365050',
    'https://t.me/connect4pro_funds',
  ],
};
const breadcrumbItems = (() => {
  const parts = Astro.url.pathname.split('/').filter(Boolean);
  const items = [{ '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://azatisrail.org/' }];
  const breadcrumbMap: Record<string, string> = {
    'posts': 'Посты',
    'publications': 'Публикации',
    'book': 'Книга',
    'funding': 'Финансирование',
    'trainings': 'Тренинги',
    'videos': 'Видео',
    'courses': 'Курсы',
    'about': 'Обо мне',
    'contact': 'Контакт',
    'support': 'Поддержать',
  };
  let url = 'https://azatisrail.org';
  parts.forEach((part, idx) => {
    url += '/' + part;
    if (breadcrumbMap[part]) {
      items.push({ '@type': 'ListItem', position: idx + 2, name: breadcrumbMap[part], item: url + '/' });
    }
  });
  return items.length > 1 ? items : [];
})();
const breadcrumbLd = breadcrumbItems.length > 0 ? {
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
} : null;

const graph = [
  person,
  {
    '@type': 'WebSite',
    '@id': 'https://azatisrail.org/#website',
    url: 'https://azatisrail.org/',
    name: 'Азат Исраилов — фандрайзинг, гранты, бизнес',
    inLanguage: lang,
    publisher: { '@id': 'https://azatisrail.org/#person' },
  },
  ...(breadcrumbLd ? [breadcrumbLd] : []),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
const ldJson = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates?.ru && <link rel="alternate" hreflang="ru" href={alternates.ru} />}
  {alternates?.en && <link rel="alternate" hreflang="en" href={alternates.en} />}
  {alternates?.ru && <link rel="alternate" hreflang="x-default" href={alternates.ru} />}
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <meta name="author" content="Азат Исраилов" />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Азат Исраилов" />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ru_RU'} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={imageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <script type="application/ld+json" set:html={ldJson} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <style is:global>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg: #F7FBF4;
      --bg-card: #EAF4EC;
      --bg-partner: #F2EDFA;
      --ink: #0F2A1E;
      --ink-muted: #4B6455;
      --accent: #1F7A4D;
      --accent-light: #5BD6A0;
      --amber: #FFB020;
      --partner: #5E3C8B;
      --partner-light: #9A7AC8;
      --border: #D6E6DA;
      --border-partner: #D6C9EE;
      --grad: linear-gradient(135deg, #1F7A4D, #3DBE86);
      --shadow-sm: 0 1px 2px rgba(15,42,30,.05), 0 6px 18px rgba(15,42,30,.06);
      --shadow-lg: 0 28px 60px -20px rgba(15,42,30,.28), 0 8px 24px rgba(15,42,30,.07);
      --serif: 'Manrope', system-ui, sans-serif;
      --sans: 'Inter', system-ui, sans-serif;
    }
    html { scroll-behavior: smooth; font-size: 17px; -webkit-text-size-adjust: 100%; }
    body { background: var(--bg); color: var(--ink); font-family: var(--sans); font-size: 1rem; line-height: 1.7; font-weight: 400; -webkit-font-smoothing: antialiased; }
    p, .art-excerpt, .pub-desc, .don-desc, .cdesc, .art-card-excerpt { white-space: pre-line; }
    a { color: inherit; }
    img { max-width: 100%; }
    h1, h2, h3, .block-title, .page-title, .post-title, .bk-title { font-family: var(--serif); font-weight: 800 !important; letter-spacing: -0.025em; }
    h1 em, h2 em, h3 em, [class*="title"] em { font-style: normal !important; color: var(--accent); }
    :focus-visible { outline: 3px solid var(--accent-light); outline-offset: 3px; border-radius: 4px; }

    /* NAV */
    .site-nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(247,251,244,0.86); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 1.25rem;
      padding: 0 2rem; height: 68px;
    }
    .nav-logo { font-family: var(--serif); font-size: 1.15rem; font-weight: 800; color: var(--ink); text-decoration: none; letter-spacing: -0.02em; white-space: nowrap; }
    .nav-links { display: flex; gap: 0.3rem; margin-left: auto; }
    .nav-links a { font-size: 0.9rem; color: var(--ink-muted); text-decoration: none; font-weight: 500; padding: 0.55rem 0.8rem; border-radius: 999px; transition: color 0.18s, background 0.18s; white-space: nowrap; }
    .nav-links a:hover, .nav-links a[aria-current="page"] { color: var(--accent); background: var(--bg-card); }
    .nav-cta { background: var(--grad); color: #fff; text-decoration: none; font-weight: 600; font-size: 0.86rem; padding: 0.62rem 1.15rem; border-radius: 999px; white-space: nowrap; box-shadow: 0 6px 16px -6px rgba(31,122,77,.6); transition: transform 0.18s, box-shadow 0.18s; }
    .nav-cta:hover { transform: translateY(-1px); box-shadow: 0 10px 20px -6px rgba(31,122,77,.7); }
    .lang-link { font-size: 0.82rem; font-weight: 600; color: var(--ink-muted); text-decoration: none; border: 1px solid var(--border); border-radius: 999px; padding: 0.35rem 0.7rem; background: #fff; }
    .lang-link:hover { color: var(--accent); border-color: var(--accent); }
    .nav-burger { display: none; margin-left: auto; width: 44px; height: 44px; border: 1px solid var(--border); border-radius: 12px; background: #fff; cursor: pointer; flex-direction: column; justify-content: center; align-items: center; gap: 5px; }
    .nav-burger span { display: block; width: 18px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform 0.2s, opacity 0.2s; }
    .nav-burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    .nav-burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .mobile-menu { position: fixed; inset: 68px 0 0 0; z-index: 99; background: var(--bg); padding: 1.25rem 1.25rem 2rem; overflow-y: auto; display: flex; flex-direction: column; gap: 0.25rem; }
    .mobile-menu[hidden] { display: none; }
    .mobile-menu a { font-family: var(--serif); font-size: 1.35rem; font-weight: 700; text-decoration: none; padding: 0.85rem 0.25rem; border-bottom: 1px solid var(--border); }
    .mobile-menu a.mm-cta { margin-top: 1rem; background: var(--grad); color: #fff; text-align: center; border: 0; border-radius: 999px; font-size: 1.05rem; padding: 1rem; }

    /* FOOTER */
    .site-footer-wrap { border-top: 1px solid var(--border); margin-top: auto; background: #fff; }
    .site-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem 2rem; flex-wrap: wrap; padding: 2rem 3rem; max-width: 1120px; margin: 0 auto; }
    .footer-copy { font-size: 0.85rem; color: var(--ink-muted); }
    .footer-links { display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; list-style: none; padding: 0; margin: 0; }
    .footer-links a { font-size: 0.85rem; color: var(--ink-muted); text-decoration: none; transition: color 0.18s; }
    .footer-links a:hover { color: var(--accent); }

    /* UTILS */
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 3rem; }
    .page-tag { font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.5rem; display: block; font-weight: 600; }
    .btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.8rem 1.5rem; font-family: var(--sans); font-size: 0.92rem; font-weight: 600; text-decoration: none; border: 2px solid var(--ink); color: var(--ink); background: transparent; border-radius: 999px; cursor: pointer; transition: transform 0.18s, background 0.18s, color 0.18s, border-color 0.18s, box-shadow 0.18s; }
    .btn:hover { background: var(--ink); border-color: var(--ink); color: #fff; }
    .btn-ghost { border-color: var(--border); color: var(--ink-muted); }
    .btn-ghost:hover { border-color: var(--accent); color: var(--accent); background: none; }
    .btn-accent { background: var(--grad); border-color: transparent; color: #fff; box-shadow: 0 10px 24px -10px rgba(31,122,77,.7); }
    .btn-accent:hover { background: var(--grad); border-color: transparent; color: #fff; transform: translateY(-2px); box-shadow: 0 14px 28px -10px rgba(31,122,77,.8); }

    /* GRID 3 */
    .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }

    /* REVEAL: content is visible by default; only animates when JS is on and motion is allowed */
    .reveal { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: no-preference) {
      .js .reveal { opacity: 0; transform: translateY(18px); transition: opacity 0.5s ease, transform 0.5s ease; }
      .js .reveal.on { opacity: 1; transform: none; }
    }

    /* BLOCK */
    .block { padding: 4.5rem 0; }
    .block-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 2.25rem; }
    .block-head-left { display: flex; flex-direction: column; gap: 0.3rem; }
    .block-tag { font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); font-weight: 600; }
    .block-title { font-size: clamp(1.7rem, 3vw, 2.4rem); line-height: 1.12; }
    .all-link { font-size: 0.9rem; color: var(--accent); text-decoration: none; font-weight: 600; white-space: nowrap; }
    .all-link:hover { text-decoration: underline; }

    @media (max-width: 1000px) {
      .nav-links, .nav-cta, .lang-link { display: none; }
      .nav-burger { display: flex; }
    }
    @media (max-width: 768px) {
      .site-nav { padding: 0 1.25rem; }
      .wrap { padding: 0 1.25rem; }
      .grid3 { grid-template-columns: 1fr; }
      .site-footer { flex-direction: column; align-items: flex-start; padding: 1.5rem 1.25rem; }
      .block { padding: 3rem 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
    }
  </style>
</head>
<body>
  <header class="site-nav">
    <a href={lang === 'en' ? '/en/' : '/'} class="nav-logo">{lang === 'en' ? 'Azat Israilov' : 'Азат Исраилов'}</a>
    <nav class="nav-links" aria-label={lang === 'en' ? 'Main menu' : 'Основное меню'}>
      {nav.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <a href={switchLang.href} class="lang-link" title={switchLang.title} hreflang={switchLang.label.toLowerCase()}>{switchLang.label}</a>
    <a href={cta.href} class="nav-cta" data-track={cta.track} target={cta.external ? '_blank' : undefined} rel={cta.external ? 'noopener' : undefined}>{cta.label}</a>
    <button class="nav-burger" type="button" aria-label={lang === 'en' ? 'Open menu' : 'Открыть меню'} aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span><span></span></button>
  </header>
  <div class="mobile-menu" id="mobile-menu" hidden>
    {mobileNav.map(([href, label]) => <a href={href}>{label}</a>)}
    <a href={switchLang.href} hreflang={switchLang.label.toLowerCase()}>{switchLang.title}</a>
    <a href={cta.href} class="mm-cta" data-track={cta.track + '_mobile'} target={cta.external ? '_blank' : undefined} rel={cta.external ? 'noopener' : undefined}>{cta.label}</a>
  </div>

  <main>
    <slot />
  </main>

  <div class="site-footer-wrap">
    <footer class="site-footer">
      <span class="footer-copy">{footerCopy}</span>
      <ul class="footer-links">
        {footerLinks.map(([label, href]) => <li><a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener' : undefined}>{label}</a></li>)}
      </ul>
    </footer>
  </div>

  <script>

    document.addEventListener('click', (e) => {
      const el = e.target.closest && e.target.closest('[data-track]');
      if (!el || typeof window.gtag !== 'function') return;
      window.gtag('event', el.getAttribute('data-track'), { link_url: el.getAttribute('href') || '', page_path: location.pathname });
    });
    const burger = document.querySelector('.nav-burger');
    const menu = document.getElementById('mobile-menu');
    if (burger && menu) {
      burger.addEventListener('click', () => {
        const open = burger.getAttribute('aria-expanded') === 'true';
        burger.setAttribute('aria-expanded', String(!open));
        burger.setAttribute('aria-label', open ? 'Открыть меню' : 'Закрыть меню');
        menu.hidden = open;
        document.body.style.overflow = open ? '' : 'hidden';
      });
      menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { menu.hidden = true; burger.setAttribute('aria-expanded', 'false'); document.body.style.overflow = ''; }));
    }
    document.querySelectorAll('.nav-links a').forEach(a => {
      const href = a.getAttribute('href');
      if (href && location.pathname.startsWith(href)) a.setAttribute('aria-current', 'page');
    });
    const reveals = document.querySelectorAll('.reveal');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('on'); io.unobserve(e.target); } });
    }, { threshold: 0.08 });
    reveals.forEach(el => io.observe(el));
  </script>
</body>
</html>
