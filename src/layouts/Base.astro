---
export interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Практические материалы по фандрайзингу, гранты, курсы и тренинги для НКО и предпринимателей.' } = Astro.props;
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Азат Исраилов</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Outfit:wght@300;400;500&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg: #F6F1E9;
      --bg-card: #EDE6D8;
      --bg-partner: #F0EBF8;
      --ink: #1C1814;
      --ink-muted: #7A6F63;
      --accent: #8B5E3C;
      --accent-light: #C8997A;
      --partner: #5E3C8B;
      --partner-light: #9A7AC8;
      --border: #D8CFC0;
      --border-partner: #C9B8E8;
      --serif: 'Cormorant Garamond', Georgia, serif;
      --sans: 'Outfit', system-ui, sans-serif;
    }
    html { scroll-behavior: smooth; }
    body { background: var(--bg); color: var(--ink); font-family: var(--sans); font-size: 16px; line-height: 1.65; font-weight: 300; }
p, .art-excerpt, .pub-desc, .don-desc, .cdesc, .art-card-excerpt { white-space: pre-line; }
    a { color: inherit; }
    img { max-width: 100%; }

    /* SHARED NAV */
    .site-nav {
      position: sticky; top: 0; z-index: 100;
      background: var(--bg); border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 3rem; height: 60px;
    }
    .nav-logo { font-family: var(--serif); font-size: 1.2rem; font-weight: 600; color: var(--ink); text-decoration: none; }
    .nav-logo span { color: var(--accent); font-style: italic; }
    .nav-links { display: flex; gap: 2rem; list-style: none; }
    .nav-links a { font-size: 0.82rem; color: var(--ink-muted); text-decoration: none; letter-spacing: 0.05em; text-transform: uppercase; transition: color 0.2s; }
    .nav-links a:hover, .nav-links a.active { color: var(--accent); }
    .lang-sw { display: flex; gap: 4px; }
    .lang-sw button { background: none; border: 1px solid transparent; border-radius: 4px; padding: 3px 8px; font-family: var(--sans); font-size: 0.78rem; color: var(--ink-muted); cursor: pointer; transition: all 0.2s; }
    .lang-sw button.on { border-color: var(--border); color: var(--accent); background: rgba(139,94,60,0.08); }

    /* SHARED FOOTER */
    .site-footer-wrap { border-top: 1px solid var(--border); margin-top: auto; }
    .site-footer { display: flex; align-items: center; justify-content: space-between; padding: 1.75rem 3rem; max-width: 1120px; margin: 0 auto; }
    .footer-copy { font-size: 0.78rem; color: var(--ink-muted); }
    .footer-links { display: flex; gap: 2rem; list-style: none; }
    .footer-links a { font-size: 0.78rem; color: var(--ink-muted); text-decoration: none; transition: color 0.2s; }
    .footer-links a:hover { color: var(--accent); }

    /* SHARED UTILS */
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 3rem; }
    .page-tag { font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.6rem; }
    .btn { display: inline-block; padding: 0.7rem 1.5rem; font-family: var(--sans); font-size: 0.82rem; font-weight: 400; letter-spacing: 0.05em; text-transform: uppercase; text-decoration: none; border: 1px solid var(--ink); color: var(--ink); transition: all 0.22s; white-space: nowrap; }
    .btn:hover { background: var(--accent); border-color: var(--accent); color: var(--bg); }
    .btn-ghost { border-color: var(--border); color: var(--ink-muted); }
    .btn-ghost:hover { border-color: var(--accent); color: var(--accent); background: none; }

    /* GRID 3 */
    .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border: 1px solid var(--border); }

    /* REVEAL */
    .reveal { opacity: 0; transform: translateY(18px); transition: opacity 0.65s ease, transform 0.65s ease; }
    .reveal.on { opacity: 1; transform: none; }

    /* BLOCK */
    .block { padding: 4rem 0; border-bottom: 1px solid var(--border); }
    .block:last-child { border-bottom: none; }
    .block-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 2rem; }
    .block-head-left { display: flex; flex-direction: column; gap: 0.25rem; }
    .block-tag { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
    .block-title { font-family: var(--serif); font-size: 1.6rem; font-weight: 500; line-height: 1.15; }
    .block-title em { font-style: italic; }
    .all-link { font-size: 0.8rem; color: var(--ink-muted); text-decoration: none; border-bottom: 1px solid var(--border); padding-bottom: 1px; letter-spacing: 0.04em; white-space: nowrap; transition: color 0.2s, border-color 0.2s; }
    .all-link:hover { color: var(--accent); border-color: var(--accent); }

    @media (max-width: 768px) {
      .site-nav { padding: 0 1.25rem; }
      .nav-links { display: none; }
      .wrap { padding: 0 1.25rem; }
      .grid3 { grid-template-columns: 1fr; }
      .site-footer { flex-direction: column; gap: 1rem; padding: 1.25rem; }
    }
  </style>
</head>
<body>
  <nav class="site-nav">
    <a href="/" class="nav-logo">Азат <span>Исраилов</span></a>
    <ul class="nav-links">
      <li><a href="/posts">Посты</a></li>
      <li><a href="/publications">Публикации</a></li>
      <li><a href="/funding">Финансирование</a></li>
      <li><a href="/trainings">Тренинги</a></li>
      <li><a href="/videos">Видео</a></li>
      <li><a href="/courses">Курсы</a></li>
      <li><a href="/about">Обо мне</a></li>
    </ul>
    <div class="lang-sw">
      <button class="on">RU</button><button>KY</button><button>EN</button>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <div class="site-footer-wrap">
    <footer class="site-footer">
      <span class="footer-copy">© 2026 · Азат Исраилов · azatisrail.org</span>
      <ul class="footer-links">
        <li><a href="/about">Обо мне</a></li>
        <li><a href="https://www.youtube.com/@connect4fund" target="_blank">YouTube</a></li>
        <li><a href="https://linkedin.com/in/azat-israilov-6b515228/" target="_blank">LinkedIn</a></li>
        <li><a href="/contact">Связаться</a></li>
      </ul>
    </footer>
  </div>

  <script>
    document.querySelectorAll('.lang-sw button').forEach(b => {
      b.addEventListener('click', function() {
        document.querySelectorAll('.lang-sw button').forEach(x => x.classList.remove('on'));
        this.classList.add('on');
      });
    });
    const reveals = document.querySelectorAll('.reveal');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('on'); io.unobserve(e.target); } });
    }, { threshold: 0.08 });
    reveals.forEach(el => io.observe(el));
  </script>
</body>
</html>
