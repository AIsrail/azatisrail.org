---
import Base from '../layouts/Base.astro';
---
<Base title="Обо мне">
<style>
  .about-grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: 0; border-bottom: 1px solid var(--border); }
  .about-left { padding: 4rem 3rem 4rem 0; border-right: 1px solid var(--border); }
  .about-right { padding: 4rem 0 4rem 3rem; }
  .avatar { width: 120px; height: 120px; border-radius: 50%; background: var(--bg-card); border: 1px solid var(--border); margin-bottom: 2rem; display: flex; align-items: center; justify-content: center; font-family: var(--serif); font-size: 2.5rem; font-weight: 500; color: var(--accent); }
  .name { font-family: var(--serif); font-size: 2rem; font-weight: 500; line-height: 1.1; margin-bottom: 0.5rem; }
  .role { font-size: 0.85rem; color: var(--ink-muted); letter-spacing: 0.05em; margin-bottom: 2rem; }
  .contact-list { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 2rem; }
  .c-row { display: flex; align-items: center; gap: 0.75rem; font-size: 0.88rem; }
  .c-lbl { font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-muted); min-width: 56px; }
  .c-val { color: var(--ink); text-decoration: none; transition: color 0.2s; }
  .c-val:hover { color: var(--accent); }
  .socials { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .social-btn { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; color: var(--ink-muted); text-decoration: none; border: 1px solid var(--border); padding: 6px 14px; border-radius: 100px; transition: all 0.2s; }
  .social-btn:hover { color: var(--accent); border-color: var(--accent-light); }
  .bio-title { font-family: var(--serif); font-size: 1.6rem; font-weight: 500; line-height: 1.15; margin-bottom: 1.5rem; }
  .bio-title em { font-style: italic; color: var(--accent); }
  .bio p { font-size: 0.95rem; color: var(--ink); line-height: 1.85; margin-bottom: 1.25rem; }
  .stats-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 0; border: 1px solid var(--border); margin-top: 3rem; }
  .stat { padding: 1.5rem; border-right: 1px solid var(--border); text-align: center; }
  .stat:last-child { border-right: none; }
  .stat-n { font-family: var(--serif); font-size: 2.2rem; font-weight: 500; color: var(--ink); line-height: 1; display: block; }
  .stat-l { font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); margin-top: 0.3rem; display: block; }
  .partners-block { padding: 3rem 0; border-bottom: 1px solid var(--border); }
  .partners-title { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-muted); margin-bottom: 1.25rem; }
  .partners-list { display: flex; flex-wrap: wrap; gap: 0; border: 1px solid var(--border); }
  .partner { padding: 1rem 1.5rem; border-right: 1px solid var(--border); font-size: 0.85rem; color: var(--ink-muted); }
  .partner:last-child { border-right: none; }
  .exp-block { padding: 3rem 0; }
  .exp-title { font-family: var(--serif); font-size: 1.5rem; font-weight: 500; margin-bottom: 2rem; }
  .exp-title em { font-style: italic; color: var(--accent); }
  .exp-list { display: flex; flex-direction: column; }
  .exp-row { display: grid; grid-template-columns: 6rem 1fr; gap: 2rem; padding: 1.5rem 0; border-bottom: 1px solid var(--border); }
  .exp-year { font-family: var(--serif); font-size: 1rem; color: var(--accent-light); padding-top: 2px; }
  .exp-name { font-weight: 400; font-size: 0.95rem; margin-bottom: 0.25rem; }
  .exp-desc { font-size: 0.85rem; color: var(--ink-muted); line-height: 1.6; }
  @media(max-width:768px){ .about-grid { grid-template-columns: 1fr; } .about-left { border-right: none; padding: 2rem 0; } .about-right { padding: 2rem 0; } .stats-row { grid-template-columns: repeat(2,1fr); } }
</style>
<div class="wrap" style="padding-top:1px">
  <div class="about-grid">
    <div class="about-left">
      <div class="avatar">АИ</div>
      <h1 class="name">Азат Исраилов</h1>
      <p class="role">Консультант · Тренер · Фандрайзер<br>Бишкек, Кыргызстан</p>
      <div class="contact-list">
        <div class="c-row"><span class="c-lbl">Тел.</span><a href="tel:+996702271827" class="c-val">+996 702 27 18 27</a></div>
        <div class="c-row"><span class="c-lbl">Email</span><a href="mailto:azat@azatisrail.org" class="c-val">azat@azatisrail.org</a></div>
        <div class="c-row"><span class="c-lbl">LinkedIn</span><a href="https://linkedin.com/in/azat-israilov-6b515228/" class="c-val" target="_blank">azat-israilov</a></div>
      </div>
      <div class="socials">
        <a href="https://www.youtube.com/@connect4fund" class="social-btn" target="_blank">▶ YouTube</a>
        <a href="https://linkedin.com/in/azat-israilov-6b515228/" class="social-btn" target="_blank">in LinkedIn</a>
        <a href="/contact" class="social-btn">✉ Написать</a>
      </div>
    </div>
    <div class="about-right">
      <h2 class="bio-title">15 лет в международном <em>развитии</em></h2>
      <div class="bio">
        <p>Помогаю предпринимателям, НКО и консультантам находить финансирование, строить устойчивые организации и выходить на новый уровень. Работаю с клиентами в Кыргызстане и странах Центральной Азии — очно в Бишкеке и онлайн.</p>
        <p>Специализируюсь на фандрайзинге и работе с донорами, разработке грантовых заявок, стратегическом планировании НКО, а также на бизнес-консалтинге и акселерации малого и среднего бизнеса.</p>
        <p>Участвую в качестве ментора в акселерационных программах Accelerate Prosperity и John Galt Foundation. Автор практических курсов и тренингов, которые прошли сотни специалистов из НКО и бизнеса.</p>
      </div>
      <div class="stats-row">
        <div class="stat"><span class="stat-n">15+</span><span class="stat-l">лет опыта</span></div>
        <div class="stat"><span class="stat-n">$2.8M</span><span class="stat-l">привлечено</span></div>
        <div class="stat"><span class="stat-n">550+</span><span class="stat-l">участников</span></div>
        <div class="stat"><span class="stat-n">36</span><span class="stat-l">стран</span></div>
      </div>
    </div>
  </div>

  <div class="partners-block">
    <p class="partners-title">Партнёры и доноры</p>
    <div class="partners-list">
      {['USAID','ООН','Eurasia Foundation','Soros Foundation','Big Lottery Fund','Hans Seidel Foundation','PeaceNexus','ICCO'].map(p => <span class="partner">{p}</span>)}
    </div>
  </div>

  <div class="exp-block">
    <h2 class="exp-title">Направления <em>работы</em></h2>
    <div class="exp-list">
      {[
        { year: '01', name: 'Бизнес-консалтинг', desc: 'Индивидуальная работа над стратегией, позиционированием и развитием бизнеса.' },
        { year: '02', name: 'Фандрайзинг и гранты', desc: 'Поиск доноров, написание заявок, выстраивание долгосрочных отношений с фондами.' },
        { year: '03', name: 'Бизнес-тренинги', desc: 'Групповые и корпоративные программы для команд и организаций по 10+ темам.' },
        { year: '04', name: 'Бизнес-планирование', desc: 'Планы под инвестора или донора — структурированные, убедительные, рабочие.' },
        { year: '05', name: 'Менторинг', desc: 'Accelerate Prosperity, John Galt — долгосрочное сопровождение предпринимателей.' },
        { year: '06', name: 'Развитие НКО', desc: 'Стратегическое планирование, оргструктура, отчётность перед донорами.' },
      ].map(e => (
        <div class="exp-row">
          <span class="exp-year">{e.year}</span>
          <div><div class="exp-name">{e.name}</div><p class="exp-desc">{e.desc}</p></div>
        </div>
      ))}
    </div>
  </div>
</div>
</Base>
