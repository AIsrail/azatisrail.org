---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const videos = (await getCollection('videos')).sort((a,b) => new Date(b.data.date??'').getTime() - new Date(a.data.date??'').getTime());
const topicLabels: Record<string,string> = { fundraising:'Фандрайзинг', ngo:'НКО', business:'Бизнес', management:'Управление' };
---
<Base title="Видео">
<style>
  .page-header { padding: 3rem 0 2rem; border-bottom: 1px solid var(--border); }
  .page-title { font-family: var(--serif); font-size: clamp(2rem,4vw,3rem); font-weight: 500; line-height: 1.1; }
  .page-title em { font-style: italic; color: var(--accent); }
  .yt-link { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.25rem; font-size: 0.85rem; color: var(--accent); text-decoration: none; border-bottom: 1px solid rgba(139,94,60,0.3); padding-bottom: 1px; }
  .vid-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 0; border: 1px solid var(--border); margin-top: 2rem; margin-bottom: 4rem; }
  .vid-card { text-decoration: none; color: inherit; display: flex; flex-direction: column; transition: background 0.22s; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); overflow: hidden; }
  .vid-card:nth-child(3n) { border-right: none; }
  .vid-card:hover { background: var(--bg-card); }
  .vid-thumb { aspect-ratio: 16/9; background: #2A2218; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .vid-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .vid-play { width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25); display: flex; align-items: center; justify-content: center; position: absolute; transition: background 0.2s; }
  .vid-card:hover .vid-play { background: var(--accent); border-color: var(--accent); }
  .vid-tri { width: 0; height: 0; border-style: solid; border-width: 7px 0 7px 14px; border-color: transparent transparent transparent white; margin-left: 3px; }
  .vid-dur { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.7); color: #fff; font-size: 0.68rem; padding: 2px 6px; }
  .vid-info { padding: 1.25rem 1.5rem; flex: 1; display: flex; flex-direction: column; gap: 0.5rem; }
  .vid-meta { font-size: 0.7rem; color: var(--ink-muted); letter-spacing: 0.04em; }
  .vid-title { font-family: var(--serif); font-size: 1.1rem; font-weight: 500; line-height: 1.3; flex: 1; }
  .vid-views { font-size: 0.73rem; color: var(--ink-muted); margin-top: auto; }
  @media(max-width:768px){ .vid-grid { grid-template-columns: 1fr; } .vid-card { border-right: none; } }
</style>
<div class="wrap">
  <div class="page-header">
    <p class="page-tag">YouTube</p>
    <h1 class="page-title">Видео и <em>разборы</em></h1>
    <a href="https://www.youtube.com/@connect4fund" target="_blank" class="yt-link">Канал @connect4fund на YouTube →</a>
  </div>
  <div class="vid-grid">
    {videos.map(v => (
      <a href={v.data.youtubeUrl} class="vid-card" target="_blank">
        <div class="vid-thumb">
          {v.data.youtubeId
            ? <img src={`https://img.youtube.com/vi/${v.data.youtubeId}/mqdefault.jpg`} alt={v.data.title} loading="lazy" />
            : null}
          <div class="vid-play"><div class="vid-tri"></div></div>
          {v.data.duration && <span class="vid-dur">{v.data.duration}</span>}
        </div>
        <div class="vid-info">
          <span class="vid-meta">
            {v.data.topic && topicLabels[v.data.topic]}
            {v.data.date && ` · ${new Date(v.data.date).toLocaleDateString('ru-RU',{month:'long',year:'numeric'})}`}
          </span>
          <div class="vid-title">{v.data.title}</div>
          {v.data.views && <span class="vid-views">{v.data.views} просмотров</span>}
        </div>
      </a>
    ))}
    {videos.length === 0 && <p style="padding:2rem;color:var(--ink-muted);grid-column:1/-1">Видео появятся в ближайшее время.</p>}
  </div>
</div>
</Base>
