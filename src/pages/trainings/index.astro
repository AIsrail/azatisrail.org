---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const trainings = await getCollection('trainings');
const topicLabels: Record<string,string> = { fundraising:'Фандрайзинг', project:'Проектирование', management:'Управление', business:'Бизнес' };
const formatLabels: Record<string,string> = { online:'Онлайн', offline:'Офлайн', both:'Онлайн · Офлайн' };
---
<Base title="Курсы и тренинги">
<style>
  .page-header { padding: 3rem 0 2rem; border-bottom: 1px solid var(--border); }
  .page-header-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; }
  .page-title { font-family: var(--serif); font-size: clamp(2rem,4vw,3rem); font-weight: 500; line-height: 1.1; }
  .page-title em { font-style: italic; color: var(--accent); }
  .page-desc { margin-top: 0.75rem; font-size: 0.95rem; color: var(--ink-muted); max-width: 540px; line-height: 1.75; }
  .page-stats { display: flex; gap: 2rem; flex-shrink: 0; }
  .pstat { text-align: center; }
  .pstat-n { font-family: var(--serif); font-size: 2.2rem; font-weight: 500; line-height: 1; display: block; }
  .pstat-l { font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); display: block; margin-top: 0.2rem; }
  .legend { display: flex; gap: 2rem; align-items: center; padding: 0.9rem 0; border-bottom: 1px solid var(--border); }
  .legend-item { display: flex; align-items: center; gap: 0.6rem; font-size: 0.8rem; color: var(--ink-muted); }
  .ldot { width: 10px; height: 10px; border-radius: 50%; }
  .ldot.own { background: var(--accent); } .ldot.partner { background: var(--partner); }
  .filters { display: flex; gap: 0.5rem; flex-wrap: wrap; padding: 1rem 0; border-bottom: 1px solid var(--border); align-items: center; }
  .fl { font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-muted); margin-right: 0.2rem; }
  .fdiv { width: 1px; height: 22px; background: var(--border); margin: 0 0.4rem; }
  .chip { padding: 4px 13px; border: 1px solid var(--border); background: none; font-family: var(--sans); font-size: 0.75rem; color: var(--ink-muted); cursor: pointer; border-radius: 100px; transition: all 0.18s; }
  .chip:hover { border-color: var(--accent-light); color: var(--accent); }
  .chip.on { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .chip.pc.on { background: var(--partner); border-color: var(--partner); color: white; }
  .freset { font-size: 0.73rem; color: var(--ink-muted); background: none; border: none; cursor: pointer; font-family: var(--sans); padding: 4px 8px; margin-left: auto; text-decoration: underline; }
  .results { font-size: 0.82rem; color: var(--ink-muted); padding: 0.75rem 0; }
  .cards-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 0; background: var(--border); border: 1px solid var(--border); margin-bottom: 4rem; }
  .card { background: var(--bg); padding: 1.75rem; display: flex; flex-direction: column; transition: background 0.22s; position: relative; }
  .card:hover { background: var(--bg-card); }
  .card.partner { background: #FAFAFF; } .card.partner:hover { background: var(--bg-partner); }
  .card.hidden { display: none; }
  .cstripe { height: 3px; width: 2.5rem; margin-bottom: 1.25rem; border-radius: 2px; }
  .cstripe.own { background: var(--accent); } .cstripe.partner { background: var(--partner); }
  .pbadge { position: absolute; top: 1.25rem; right: 1.25rem; font-size: 0.63rem; letter-spacing: 0.1em; text-transform: uppercase; background: var(--bg-partner); color: var(--partner); border: 1px solid var(--border-partner); padding: 2px 8px; border-radius: 100px; }
  .ctopics { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
  .ctag { font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 9px; border-radius: 100px; border: 1px solid; }
  .ctag.own { color: var(--accent); border-color: rgba(139,94,60,0.25); background: rgba(139,94,60,0.06); }
  .ctag.partner { color: var(--partner); border-color: rgba(94,60,139,0.25); background: rgba(94,60,139,0.06); }
  .ctitle { font-family: var(--serif); font-size: 1.2rem; font-weight: 500; line-height: 1.3; margin-bottom: 0.75rem; }
  .cdesc { font-size: 0.84rem; color: var(--ink-muted); line-height: 1.7; margin-bottom: 1.25rem; flex: 1; }
  .cmeta { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 1rem; margin-bottom: 1.25rem; }
  .ml { font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-muted); display: block; margin-bottom: 0.15rem; }
  .mv { font-size: 0.8rem; color: var(--ink); }
  .mv.oc { color: var(--accent); } .mv.pc2 { color: var(--partner); }
  .apills { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .apill { font-size: 0.65rem; padding: 2px 7px; border-radius: 100px; background: var(--bg-card); color: var(--ink-muted); border: 1px solid var(--border); }
  .cdiv { border: none; border-top: 1px solid var(--border); margin: 1.25rem 0; }
  .trainer { display: flex; align-items: center; gap: 0.85rem; margin-bottom: 1rem; }
  .tavatar { width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-family: var(--serif); font-size: 0.95rem; font-weight: 500; }
  .tavatar.own { background: rgba(139,94,60,0.12); color: var(--accent); }
  .tavatar.partner { background: rgba(94,60,139,0.12); color: var(--partner); }
  .tname { font-size: 0.86rem; font-weight: 500; color: var(--ink); line-height: 1.2; }
  .trole { font-size: 0.73rem; color: var(--ink-muted); }
  .ccontacts { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 1rem; }
  .crow { display: flex; align-items: center; gap: 0.5rem; font-size: 0.78rem; color: var(--ink-muted); }
  .clinks { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .clink { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; color: var(--ink-muted); text-decoration: none; border: 1px solid var(--border); padding: 4px 11px; border-radius: 100px; transition: all 0.18s; }
  .clink:hover { color: var(--accent); border-color: var(--accent-light); }
  .clink.plink:hover { color: var(--partner); border-color: var(--partner-light); }
  .no-results { text-align: center; padding: 4rem 0; color: var(--ink-muted); display: none; }
  @media(max-width:768px){ .cards-grid { grid-template-columns: 1fr; } .page-header-row { flex-direction: column; } .cmeta { grid-template-columns: 1fr; } }
</style>
<div class="wrap">
  <div class="page-header">
    <div class="page-header-row">
      <div>
        <p class="page-tag">Обучение</p>
        <h1 class="page-title">Курсы и <em>тренинги</em></h1>
        <p class="page-desc">Практические программы по фандрайзингу, проектированию и управлению. Тренинги Азата Исраилова и партнёров.</p>
      </div>
      <div class="page-stats">
        <div class="pstat"><span class="pstat-n" id="cnt">{trainings.length}</span><span class="pstat-l">тренингов</span></div>
        <div class="pstat"><span class="pstat-n">10+</span><span class="pstat-l">тем</span></div>
        <div class="pstat"><span class="pstat-n">1–3</span><span class="pstat-l">дня</span></div>
      </div>
    </div>
  </div>
  <div class="legend">
    <div class="legend-item"><div class="ldot own"></div>Тренинги Азата Исраилова</div>
    <div class="legend-item"><div class="ldot partner"></div>Тренинги партнёров</div>
  </div>
  <div class="filters">
    <span class="fl">Тема</span>
    <button class="chip on" data-f="topic" data-v="all">Все</button>
    <button class="chip" data-f="topic" data-v="fundraising">Фандрайзинг</button>
    <button class="chip" data-f="topic" data-v="project">Проектирование</button>
    <button class="chip" data-f="topic" data-v="management">Управление</button>
    <button class="chip" data-f="topic" data-v="business">Бизнес</button>
    <div class="fdiv"></div>
    <span class="fl">Формат</span>
    <button class="chip on" data-f="format" data-v="all">Все</button>
    <button class="chip" data-f="format" data-v="offline">Офлайн</button>
    <button class="chip" data-f="format" data-v="online">Онлайн</button>
    <div class="fdiv"></div>
    <span class="fl">Автор</span>
    <button class="chip on" data-f="author" data-v="all">Все</button>
    <button class="chip" data-f="author" data-v="own">Азат</button>
    <button class="chip pc" data-f="author" data-v="partner">Партнёры</button>
    <button class="freset" id="rst">Сбросить</button>
  </div>
  <p class="results" id="rtxt">Показаны все {trainings.length} тренинга</p>

  <div class="cards-grid" id="grid">
    {trainings.map(t => {
      const isP = t.data.isPartner;
      const cls = isP ? 'partner' : '';
      const tagCls = isP ? 'partner' : 'own';
      return (
        <div class={`card ${cls}`} data-topics={t.data.topics.join(',')} data-format={t.data.format} data-author={isP ? 'partner' : 'own'}>
          <div class={`cstripe ${tagCls}`}></div>
          {isP && <span class="pbadge">Партнёр</span>}
          <div class="ctopics">
            {t.data.topics.map(tp => <span class={`ctag ${tagCls}`}>{topicLabels[tp] ?? tp}</span>)}
          </div>
          <h2 class="ctitle">{t.data.title}</h2>
          <p class="cdesc">{t.data.description}</p>
          <div class="cmeta">
            <div><span class="ml">Длительность</span><span class={`mv ${isP?'pc2':'oc'}`}>{t.data.duration}</span></div>
            <div><span class="ml">Формат</span><span class="mv">{formatLabels[t.data.format]}</span></div>
            <div style="grid-column:1/-1"><span class="ml">Аудитория</span>
              <div class="apills">{t.data.audience.map(a => <span class="apill">{a}</span>)}</div>
            </div>
          </div>
          <hr class="cdiv" />
          <div class="trainer">
            <div class={`tavatar ${tagCls}`}>{t.data.trainerInitials}</div>
            <div><div class="tname">{t.data.trainerName}</div><div class="trole">{t.data.trainerRole}</div></div>
          </div>
          <div class="ccontacts">
            {t.data.contactEmail && <div class="crow"><span style="opacity:.5">✉</span><span>{t.data.contactEmail}</span></div>}
            {t.data.contactPhone && <div class="crow"><span style="opacity:.5">📱</span><span>{t.data.contactPhone}</span></div>}
          </div>
          {t.data.links && t.data.links.length > 0 && (
            <div class="clinks">
              {t.data.links.map(l => <a href={l.url} class={`clink ${isP?'plink':''}`} target="_blank">↗ {l.label}</a>)}
            </div>
          )}
        </div>
      );
    })}
    {trainings.length === 0 && <p style="padding:2rem;color:var(--ink-muted);grid-column:1/-1">Тренинги появятся в ближайшее время.</p>}
  </div>
  <p class="no-results" id="nores">Нет тренингов по выбранным фильтрам. <button style="background:none;border:none;cursor:pointer;text-decoration:underline;font-family:var(--sans)" onclick="resetAll()">Сбросить</button></p>
</div>

<script>
  const state = { topic:'all', format:'all', author:'all' };
  function run() {
    const cards = document.querySelectorAll('.card');
    let n = 0;
    cards.forEach(c => {
      const topics = c.dataset.topics.split(',');
      const ok = (state.topic==='all'||topics.includes(state.topic))
               && (state.format==='all'||c.dataset.format===state.format||c.dataset.format==='both')
               && (state.author==='all'||c.dataset.author===state.author);
      c.classList.toggle('hidden',!ok);
      if(ok) n++;
    });
    document.getElementById('cnt').textContent = n;
    document.getElementById('rtxt').textContent = n===0?'Нет подходящих тренингов':`Показано ${n} тренинга`;
    document.getElementById('nores').style.display = n===0?'block':'none';
    document.getElementById('grid').style.display = n===0?'none':'grid';
  }
  document.querySelectorAll('.chip').forEach(chip => {
    chip.addEventListener('click', function() {
      const f = this.dataset.f;
      document.querySelectorAll(`[data-f="${f}"]`).forEach(c => c.classList.remove('on'));
      this.classList.add('on');
      state[f] = this.dataset.v;
      run();
    });
  });
  function resetAll() {
    Object.keys(state).forEach(k => state[k]='all');
    document.querySelectorAll('.chip').forEach(c => c.classList.remove('on'));
    document.querySelectorAll('[data-v="all"]').forEach(c => c.classList.add('on'));
    run();
  }
  document.getElementById('rst').addEventListener('click', resetAll);
</script>
</Base>
