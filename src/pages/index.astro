---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a,b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0,3);
const publications = (await getCollection('publications')).slice(0,3);
const funding = (await getCollection('funding')).slice(0,3);
const videos = (await getCollection('videos')).sort((a,b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0,3);
const courses = (await getCollection('courses')).slice(0,3);
const trainings = (await getCollection('trainings')).sort((a, b) => {
  const da = a.data.date ? new Date(a.data.date).getTime() : 0;
  const db = b.data.date ? new Date(b.data.date).getTime() : 0;
  return db - da;
});
const latestTraining = trainings.find(t => !t.data.isPartner) ?? trainings[0];

const tagLabels: Record<string,string> = {
  fundraising: 'Фандрайзинг', ngo: 'НКО', business: 'Бизнес',
  acceleration: 'Акселерация', management: 'Управление', other: 'Разное'
};
const categoryLabels: Record<string,string> = { grants: 'Гранты', investors: 'Инвестиции', banks: 'Банки' };
const pubTypeLabels: Record<string,string> = { guide:'Руководство', article:'Статья', pdf:'Гайд / PDF', tool:'Инструмент', book:'Книга' };
---
<Base title="Фандрайзинг. Бизнес. Инструменты для роста.">
<style>
  .hero { padding: 5rem 3rem 4.5rem; display: flex; align-items: flex-end; justify-content: space-between; border-bottom: 1px solid var(--border); gap: 3rem; max-width: 1120px; margin: 0 auto; }
  .hero h1 { font-family: var(--serif); font-size: clamp(3rem,5.5vw,5rem); font-weight: 500; line-height: 1.0; letter-spacing: -0.02em; }
  .hero h1 em { font-style: italic; color: var(--accent); }
  .hero p { margin-top: 1.25rem; font-size: 1rem; color: var(--ink-muted); max-width: 400px; line-height: 1.75; }
  .hero-actions { display: flex; flex-direction: column; gap: 0.75rem; flex-shrink: 0; }

  /* ARTICLE CARDS */
  .art-card { padding: 1.75rem; border-right: 1px solid var(--border); text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 0.75rem; transition: background 0.22s; }
  .art-card:last-child { border-right: none; }
  .art-card:hover { background: var(--bg-card); }
  .art-tag { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .art-title { font-family: var(--serif); font-size: 1.2rem; font-weight: 500; line-height: 1.3; flex: 1; }
  .art-excerpt { font-size: 0.84rem; color: var(--ink-muted); line-height: 1.65; }
  .art-foot { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border); }
  .art-date { font-size: 0.75rem; color: var(--ink-muted); }
  .art-arrow { font-size: 0.9rem; color: var(--accent-light); transition: transform 0.2s; }
  .art-card:hover .art-arrow { transform: translate(3px,-3px); }

  /* PUB CARDS */
  .pub-card { padding: 1.75rem; border-right: 1px solid var(--border); text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 0.6rem; transition: background 0.22s; }
  .pub-card:last-child { border-right: none; }
  .pub-card:hover { background: var(--bg-card); }
  .pub-type { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-muted); }
  .pub-icon { font-size: 2rem; line-height: 1; }
  .pub-title { font-family: var(--serif); font-size: 1.15rem; font-weight: 500; line-height: 1.3; flex: 1; }
  .pub-desc { font-size: 0.84rem; color: var(--ink-muted); line-height: 1.6; }
  .pub-cta { font-size: 0.78rem; color: var(--accent); margin-top: 0.5rem; }
  .pub-card-market { padding: 0; }
  .pub-card-market .pub-type { padding: 1rem 1.25rem 0; }
  .pub-card-market .pub-title { padding: 0 1.25rem; }
  .pub-card-market .pub-desc { padding: 0 1.25rem; }
  .pub-card-market .pub-cta { padding: 0 1.25rem 1.25rem; }
  .pub-market-cover { position: relative; aspect-ratio: 4/3; background: var(--bg); display: flex; align-items: center; justify-content: center; overflow: hidden; border-bottom: 1px solid var(--border); }
  .pub-market-cover img { max-height: 92%; max-width: 78%; object-fit: contain; filter: drop-shadow(0 8px 18px rgba(28,24,20,0.18)); transition: transform 0.25s; }
  .pub-card-market:hover .pub-market-cover img { transform: scale(1.04); }
  .pub-market-price { position: absolute; top: 0.85rem; right: 0.85rem; background: var(--ink); color: var(--bg); font-family: var(--serif); font-size: 0.95rem; font-weight: 500; padding: 4px 12px; }

  /* FUNDING CARDS */
  .don-card { padding: 1.75rem; border-right: 1px solid var(--border); text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 0.6rem; transition: background 0.22s; }
  .don-card:last-child { border-right: none; }
  .don-card:hover { background: var(--bg-card); }
  .don-cat { display: inline-flex; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--bg); background: var(--accent); padding: 3px 10px; align-self: flex-start; }
  .don-name { font-family: var(--serif); font-size: 1.5rem; font-weight: 500; line-height: 1.1; }
  .don-desc { font-size: 0.84rem; color: var(--ink-muted); line-height: 1.6; flex: 1; }
  .don-meta { display: flex; gap: 1rem; font-size: 0.75rem; color: var(--ink-muted); margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border); }

  /* AI BLOCK */
  .ai-block { background: #1C1814; border-radius: 2px; padding: 3rem; display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  .ai-tag { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-light); margin-bottom: 0.75rem; }
  .ai-title { font-family: var(--serif); font-size: 2rem; font-weight: 500; line-height: 1.2; margin-bottom: 1rem; color: var(--bg); }
  .ai-title em { font-style: italic; color: var(--accent-light); }
  .ai-desc { font-size: 0.9rem; color: rgba(246,241,233,0.65); line-height: 1.75; margin-bottom: 1.5rem; }
  .ai-soon { display: inline-flex; align-items: center; gap: 0.6rem; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); color: rgba(246,241,233,0.5); font-size: 0.82rem; letter-spacing: 0.05em; padding: 0.75rem 1.5rem; }
  .ai-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent-light); animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
  .ai-tiers { display: flex; flex-direction: column; border: 1px solid rgba(255,255,255,0.1); }
  .ai-tier { padding: 1rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: space-between; }
  .ai-tier:last-child { border-bottom: none; }
  .ai-tier-name { font-size: 0.85rem; color: rgba(246,241,233,0.75); }
  .ai-tier-price { font-family: var(--serif); font-size: 1.1rem; color: var(--accent-light); }

  /* VIDEO CARDS */
  .vid-card { text-decoration: none; color: inherit; display: flex; flex-direction: column; transition: background 0.22s; border-right: 1px solid var(--border); overflow: hidden; }
  .vid-card:last-child { border-right: none; }
  .vid-card:hover { background: var(--bg-card); }
  .vid-thumb { aspect-ratio: 16/9; background: #2A2218; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .vid-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .vid-play { width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25); display: flex; align-items: center; justify-content: center; position: absolute; transition: background 0.2s; }
  .vid-card:hover .vid-play { background: var(--accent); border-color: var(--accent); }
  .vid-play-icon { width: 0; height: 0; border-style: solid; border-width: 7px 0 7px 14px; border-color: transparent transparent transparent white; margin-left: 3px; }
  .vid-duration { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.7); color: #fff; font-size: 0.7rem; padding: 2px 6px; }
  .vid-info { padding: 1.25rem 1.5rem; flex: 1; display: flex; flex-direction: column; gap: 0.5rem; }
  .vid-meta { font-size: 0.72rem; color: var(--ink-muted); letter-spacing: 0.05em; }
  .vid-title { font-family: var(--serif); font-size: 1.1rem; font-weight: 500; line-height: 1.3; flex: 1; }
  .vid-views { font-size: 0.75rem; color: var(--ink-muted); margin-top: auto; }

  /* COURSE CARDS */
  .course-card { padding: 1.75rem; border-right: 1px solid var(--border); text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 0.75rem; transition: background 0.22s; }
  .course-card:last-child { border-right: none; }
  .course-card:hover { background: var(--bg-card); }
  .course-badge { display: inline-flex; align-self: flex-start; background: var(--bg-card); border: 1px solid var(--border); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 10px; color: var(--ink-muted); }
  .course-badge.featured { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .course-title { font-family: var(--serif); font-size: 1.2rem; font-weight: 500; line-height: 1.3; flex: 1; }
  .course-desc { font-size: 0.84rem; color: var(--ink-muted); line-height: 1.65; }
  .course-meta { display: flex; gap: 1rem; font-size: 0.75rem; color: var(--ink-muted); padding-top: 0.75rem; border-top: 1px solid var(--border); margin-top: auto; align-items: center; }
  .course-price { font-family: var(--serif); font-size: 1.1rem; color: var(--ink); font-weight: 500; margin-left: auto; }

  @media (max-width: 768px) {
    .hero { flex-direction: column; padding: 2rem 1.25rem; }
  }

  /* BOOK PROMO */
  .book-promo {
    background: var(--bg-card); border: 1px solid var(--border);
    display: grid; grid-template-columns: 220px 1fr auto; gap: 2.5rem;
    align-items: center; padding: 2.5rem;
  }
  .book-promo-cover { width: 100%; filter: drop-shadow(0 10px 24px rgba(28,24,20,0.16)); }
  .book-promo-tag { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.6rem; }
  .book-promo-title { font-family: var(--serif); font-size: 1.8rem; font-weight: 500; line-height: 1.15; margin-bottom: 0.75rem; }
  .book-promo-title em { font-style: italic; color: var(--accent); }
  .book-promo-desc { font-size: 0.9rem; color: var(--ink-muted); line-height: 1.75; max-width: 480px; }
  .book-promo-right { display: flex; flex-direction: column; align-items: flex-end; gap: 1rem; }
  .book-promo-price { font-family: var(--serif); font-size: 1.6rem; font-weight: 500; color: var(--ink); white-space: nowrap; }
  @media (max-width: 900px) {
    .book-promo { grid-template-columns: 1fr; text-align: center; padding: 2rem; }
    .book-promo-cover { max-width: 160px; margin: 0 auto; }
    .book-promo-right { align-items: center; }
    .book-promo-desc { margin: 0 auto; }
  }

  /* ЗНАНИЯ & НАВЫКИ — unified trainings + video section */
  .knowledge-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 0; border: 1px solid var(--border); }

  /* training promo (left) */
  .training-promo {
    background: var(--ink); padding: 3rem;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .training-promo-live {
    display: inline-flex; align-items: center; gap: 0.6rem; align-self: flex-start;
    font-size: 0.78rem; color: var(--accent-light); letter-spacing: 0.03em;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);
    padding: 0.4rem 1rem;
  }
  .live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent-light); animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
  .training-promo-title { font-family: var(--serif); font-size: 1.7rem; font-weight: 500; color: var(--bg); line-height: 1.25; }
  .training-promo-text { font-size: 0.92rem; color: rgba(246,241,233,0.7); line-height: 1.7; }
  .training-promo-sub { font-size: 0.85rem; color: rgba(246,241,233,0.45); line-height: 1.7; padding-top: 0.5rem; border-top: 1px solid rgba(255,255,255,0.1); margin-top: 0.25rem; }
  .training-promo-ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .training-promo-ctas .btn { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .training-promo-ctas .btn:hover { background: var(--accent-light); border-color: var(--accent-light); }
  .training-promo-ctas .btn-ghost { color: rgba(246,241,233,0.6); border-color: rgba(255,255,255,0.18); }
  .training-promo-ctas .btn-ghost:hover { color: var(--bg); border-color: rgba(255,255,255,0.4); background: none; }

  /* video side (right) */
  .video-side { padding: 2rem; border-left: 1px solid var(--border); display: flex; flex-direction: column; }
  .video-side-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; }
  .video-side-label { font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-muted); }
  .video-side-list { display: flex; flex-direction: column; gap: 1rem; }
  .vid-mini { display: flex; gap: 0.85rem; text-decoration: none; color: inherit; align-items: center; transition: opacity 0.2s; }
  .vid-mini:hover { opacity: 0.8; }
  .vid-mini-thumb { width: 92px; aspect-ratio: 16/9; background: #2A2218; position: relative; flex-shrink: 0; overflow: hidden; }
  .vid-mini-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .vid-mini-play { position: absolute; inset: 0; margin: auto; width: 22px; height: 22px; border-radius: 50%; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; }
  .vid-mini-play::after { content: ''; width: 0; height: 0; border-style: solid; border-width: 4px 0 4px 7px; border-color: transparent transparent transparent white; margin-left: 2px; }
  .vid-mini-duration { position: absolute; bottom: 3px; right: 3px; background: rgba(0,0,0,0.7); color: #fff; font-size: 0.6rem; padding: 1px 4px; }
  .vid-mini-info { min-width: 0; }
  .vid-mini-title { font-size: 0.85rem; font-weight: 400; color: var(--ink); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .vid-mini-views { font-size: 0.72rem; color: var(--ink-muted); margin-top: 0.2rem; display: block; }

  @media (max-width: 900px) {
    .knowledge-grid { grid-template-columns: 1fr; }
    .video-side { border-left: none; border-top: 1px solid var(--border); }
  }
</style>

<!-- HERO -->
<div style="border-bottom:1px solid var(--border); background: linear-gradient(170deg, var(--bg) 60%, var(--bg-card) 100%);">
  <div class="hero">
    <div>
      <p style="font-size:0.72rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent);font-weight:500;margin-bottom:1.25rem;display:flex;align-items:center;gap:0.75rem">
        <span style="width:2rem;height:1px;background:var(--accent);display:inline-block"></span>
        Бишкек · Центральная Азия · Международный опыт
      </p>
      <h1>Фандрайзинг.<br>Бизнес.<br><em>Инструменты для роста.</em></h1>
      <p style="margin-top:1.25rem">Практические материалы и курсы для НКО,<br>предпринимателей и консультантов ЦА.</p>
    </div>
    <div class="hero-actions">
      <a href="#ai" class="btn btn-accent">ИИ-поиск финансирования</a>
      <a href="/about" class="btn btn-ghost">Обо мне →</a>
    </div>
  </div>
</div>

<!-- BOOK PROMO -->
<div class="wrap" style="padding-top:2rem">
  <a href="/book" class="book-promo" style="text-decoration:none;color:inherit;display:grid">
    <img src="/book-cover.png" alt="Как привлечь денежный грант" class="book-promo-cover" />
    <div>
      <p class="book-promo-tag">Книга · 2-е издание · Уже в продаже</p>
      <h2 class="book-promo-title">Как привлечь <em>денежный грант</em><br>в бизнес или проект</h2>
      <p class="book-promo-desc">Авторская методология «3 Дерева»®, гранты для бизнеса и НКО, работа с ИИ, 40+ источников финансирования. Более 250 страниц практики.</p>
    </div>
    <div class="book-promo-right">
      <span class="book-promo-price">1 900 сом</span>
      <span class="btn">Узнать подробнее →</span>
    </div>
  </a>
</div>

<div class="wrap">

  <!-- ① ПОСТЫ -->
  <div class="block reveal">
    <div class="block-head">
      <div class="block-head-left">
        <span class="block-tag">Свежее</span>
        <h2 class="block-title">Статьи и <em>посты</em></h2>
      </div>
      <a href="/posts" class="all-link">Все посты →</a>
    </div>
    <div class="grid3">
      {posts.map(post => (
        <a href={`/posts/${post.slug}`} class="art-card">
          <span class="art-tag">{tagLabels[post.data.tag] ?? post.data.tag}</span>
          <div class="art-title">{post.data.title}</div>
          <p class="art-excerpt">{post.data.excerpt}</p>
          <div class="art-foot">
            <span class="art-date">{new Date(post.data.date).toLocaleDateString('ru-RU', {day:'numeric',month:'long',year:'numeric'})}</span>
            <span class="art-arrow">↗</span>
          </div>
        </a>
      ))}
      {posts.length === 0 && <p style="padding:2rem;color:var(--ink-muted);grid-column:1/-1">Скоро появятся посты.</p>}
    </div>
  </div>

  <!-- ② ПУБЛИКАЦИИ -->
  <div class="block reveal">
    <div class="block-head">
      <div class="block-head-left">
        <span class="block-tag">Материалы</span>
        <h2 class="block-title">Руководства и <em>публикации</em></h2>
      </div>
      <a href="/publications" class="all-link">Все публикации →</a>
    </div>
    <div class="grid3">
      {publications.map(pub => {
        const isInternal = pub.data.link?.startsWith('/');
        const href = pub.data.link ?? `/publications/${pub.slug}`;
        return pub.data.image ? (
          <a href={href} class="pub-card pub-card-market" target={isInternal ? undefined : '_blank'}>
            <div class="pub-market-cover">
              <img src={pub.data.image} alt={pub.data.title} loading="lazy" />
              {pub.data.price && <span class="pub-market-price">{pub.data.price}</span>}
            </div>
            <span class="pub-type">{pubTypeLabels[pub.data.type] ?? pub.data.type}</span>
            <div class="pub-title">{pub.data.title}</div>
            <p class="pub-desc">{pub.data.description}</p>
            <span class="pub-cta">{pub.data.cta}</span>
          </a>
        ) : (
          <a href={href} class="pub-card" target={isInternal ? undefined : '_blank'}>
            <span class="pub-type">{pubTypeLabels[pub.data.type] ?? pub.data.type}</span>
            <div class="pub-icon">{pub.data.icon}</div>
            <div class="pub-title">{pub.data.title}</div>
            <p class="pub-desc">{pub.data.description}</p>
            <span class="pub-cta">{pub.data.cta}</span>
          </a>
        );
      })}
      {publications.length === 0 && <p style="padding:2rem;color:var(--ink-muted);grid-column:1/-1">Скоро появятся публикации.</p>}
    </div>
  </div>

  <!-- ③ ФИНАНСИРОВАНИЕ -->
  <div class="block reveal">
    <div class="block-head">
      <div class="block-head-left">
        <span class="block-tag">Каталог</span>
        <h2 class="block-title">Источники <em>финансирования</em></h2>
      </div>
      <a href="/funding" class="all-link">Весь каталог →</a>
    </div>
    <div class="grid3">
      {funding.map(f => (
        <a href={f.data.link ?? `/funding`} class="don-card" target={f.data.link ? '_blank' : undefined}>
          <span class="don-cat">{categoryLabels[f.data.category] ?? f.data.category}</span>
          <div class="don-name">{f.data.name}</div>
          <p class="don-desc">{f.data.description}</p>
          <div class="don-meta">
            <span>{f.data.count}</span>
            {f.data.geography && <span>{f.data.geography}</span>}
          </div>
        </a>
      ))}
      {funding.length === 0 && <p style="padding:2rem;color:var(--ink-muted);grid-column:1/-1">Каталог в разработке.</p>}
    </div>
  </div>

</div>

<!-- ④ ИИ-ПОМОЩНИК -->
<div class="wrap">
  <div class="block reveal" id="ai">
    <div class="block-head">
      <div class="block-head-left">
        <span class="block-tag">Скоро</span>
        <h2 class="block-title">ИИ-помощник по <em>финансированию</em></h2>
      </div>
    </div>
    <div class="ai-block">
      <div>
        <p class="ai-tag">Умный поиск источников</p>
        <h3 class="ai-title">Найди финансирование<br><em>под свой проект</em></h3>
        <p class="ai-desc">Опиши задачу — ИИ подберёт подходящие источники из базы доноров, инвесторов и программ. Базовый поиск бесплатно, разработка документов платно.</p>
        <div class="ai-soon">
          <div class="ai-dot"></div>
          В разработке — запуск в ближайшее время
        </div>
      </div>
      <div class="ai-tiers">
        <div class="ai-tier">
          <span class="ai-tier-name">Поиск источников — «подходит / не подходит»</span>
          <span class="ai-tier-price">Бесплатно</span>
        </div>
        <div class="ai-tier">
          <span class="ai-tier-name">Разработка концепции проекта</span>
          <span class="ai-tier-price">Платно</span>
        </div>
        <div class="ai-tier">
          <span class="ai-tier-name">Подготовка основного документа</span>
          <span class="ai-tier-price">Платно</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="wrap">

  <!-- ⑤ ЗНАНИЯ & НАВЫКИ -->
  <div class="block reveal">
    <div class="block-head">
      <div class="block-head-left">
        <span class="block-tag">Обучение · 10+ тем</span>
        <h2 class="block-title">Знания <em>&amp;</em> навыки</h2>
      </div>
    </div>
    <div class="knowledge-grid">

      <!-- TRAINING PROMO (left, primary) -->
      <div class="training-promo">
        {latestTraining && (
          <>
            <div class="training-promo-live">
              <span class="live-dot"></span>
              {latestTraining.data.date
                ? `Ближайший тренинг · ${new Date(latestTraining.data.date).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' })}`
                : 'Ближайший тренинг'}
            </div>
            <h3 class="training-promo-title">{latestTraining.data.title.replace(/^[^\wа-яА-Я]+/, '')}</h3>
            <p class="training-promo-text">{latestTraining.data.excerpt ?? 'Практическая методология разработки проектов — от идеи до готовой заявки на грант.'}</p>
          </>
        )}
        <p class="training-promo-sub">
          Помимо этого — программы по проектированию, управлению и развитию бизнеса. Очно в Бишкеке и онлайн для всей Центральной Азии.
        </p>
        <div class="training-promo-ctas">
          <a href="/trainings" class="btn">Смотреть все тренинги →</a>
          <a href="/contact" class="btn btn-ghost">Провести тренинг с нами</a>
        </div>
      </div>

      <!-- VIDEOS (right, compact) -->
      <div class="video-side">
        <div class="video-side-head">
          <span class="video-side-label">YouTube · разборы</span>
          <a href="https://www.youtube.com/@connect4fund" class="all-link" target="_blank">Все видео →</a>
        </div>
        <div class="video-side-list">
          {videos.slice(0,3).map(v => (
            <a href={v.data.youtubeUrl} class="vid-mini" target="_blank">
              <div class="vid-mini-thumb">
                {v.data.youtubeId
                  ? <img src={`https://img.youtube.com/vi/${v.data.youtubeId}/mqdefault.jpg`} alt={v.data.title} loading="lazy" />
                  : null}
                <div class="vid-mini-play"></div>
                {v.data.duration && <span class="vid-mini-duration">{v.data.duration}</span>}
              </div>
              <div class="vid-mini-info">
                <div class="vid-mini-title">{v.data.title}</div>
                {v.data.views && <span class="vid-mini-views">{v.data.views} просмотров</span>}
              </div>
            </a>
          ))}
          {videos.length === 0 && <p style="color:var(--ink-muted);font-size:0.85rem">Скоро появятся видео.</p>}
        </div>
      </div>

    </div>
  </div>

</div>
</Base>
