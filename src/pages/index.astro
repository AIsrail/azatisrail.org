---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a,b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0,3);
const publications = (await getCollection('publications')).slice(0,3);
const funding = (await getCollection('funding')).slice(0,3);
const videos = (await getCollection('videos')).sort((a,b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0,3);
const courses = (await getCollection('courses')).slice(0,3);

const tagLabels: Record<string,string> = {
  fundraising: 'Фандрайзинг', ngo: 'НКО', business: 'Бизнес',
  acceleration: 'Акселерация', management: 'Управление', other: 'Разное',
  book: 'Книга', about: 'Об авторе', fundan: 'Fundan'
};
const categoryLabels: Record<string,string> = { grants: 'Гранты', investors: 'Инвестиции', banks: 'Банки' };
const pubTypeLabels: Record<string,string> = { guide:'Руководство', article:'Статья', pdf:'Гайд / PDF', tool:'Инструмент', book:'Книга' };

const faq = [
  { q: 'Может ли бизнес получить грант?', a: 'Да. Гранты получают не только НКО, но и коммерческие компании. Для бизнеса грант — способ проверить новую идею или продукт и снизить риск, если проект не получится. Нужно найти донора, чьи приоритеты совпадают с вашими, и показать, какую пользу проект принесёт людям, а не только компании. Условия у каждого конкурса свои, поэтому всегда читайте требования донора.' },
  { q: 'Может ли стартап получить грант?', a: 'Да. Стартап может подать заявку на конкурс, который поддерживает новые продукты и технологии. На таких конкурсах можно запустить продукт, проверить спрос и расти дальше, если идея сработала. Если нет, проект можно закрыть и попробовать другое направление. Донору обычно нужны чёткая проблема, понятный результат и обоснованный бюджет. Часто важны юридическая регистрация и местные учредители, поэтому сверьтесь с условиями конкурса.' },
  { q: 'Как получить грант для бизнеса в Кыргызстане?', a: 'Сначала найдите донора, чьи приоритеты совпадают с вашей задачей: международные фонды, программы развития и банки регулярно объявляют конкурсы для МСБ в Центральной Азии. Затем сформулируйте проблему, решение и измеримый результат по методологии «3 Дерева» и подготовьте заявку строго по форме донора. Каталог 60+ доноров есть в разделе «Источники финансирования».' },
  { q: 'Может ли НКО получить грант без опыта?', a: 'Да. Многие доноры выделяют малые гранты для новых организаций. Важно показать чёткую проблему, реалистичный бюджет и команду, способную выполнить проект. Начинать лучше с малых грантов и партнёрства с опытными организациями.' },
  { q: 'Что такое методология «3 Дерева»?', a: '«3 Дерева»® — авторская методология Азата Исраилова для подготовки грантовых заявок и бизнес-планов: дерево проблем, дерево целей и дерево действий. Она помогает выстроить логику проекта так, чтобы донор увидел связь между проблемой, действиями и результатом.' },
  { q: 'Чем помогает консультант по фандрайзингу?', a: 'Консультант помогает найти подходящих доноров, выстроить логику проекта, написать и проверить заявку, составить бюджет и подготовиться к отчётности. Азат Исраилов работает с НКО, предпринимателями и консультантами Центральной Азии очно в Бишкеке и онлайн.' },
  { q: 'Где купить книгу «Как привлечь денежный грант»?', a: '2-е издание книги (2026, 232 страницы, 1 900 сом) можно заказать на странице «Книга» на azatisrail.org.' },
];
const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base alternates={{ ru: 'https://azatisrail.org/', en: 'https://azatisrail.org/en/' }} title="Фандрайзинг, гранты и бизнес-консалтинг в Центральной Азии" description="Азат Исраилов — консультант по фандрайзингу из Бишкека: как получить грант для бизнеса и НКО, методология «3 Дерева», книга, курсы, тренинги и каталог 60+ доноров Центральной Азии." jsonLd={faqLd}>
<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; isolation: isolate; background: radial-gradient(120% 90% at 85% 0%, #E2F5E8 0%, var(--bg) 60%); }
  .aurora { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .aurora i { position: absolute; border-radius: 50%; filter: blur(70px); animation: drift 18s ease-in-out infinite alternate; will-change: transform; }
  .aurora i:nth-child(1) { width: 420px; height: 420px; right: 6%; top: -80px; background: rgba(91,214,160,.45); }
  .aurora i:nth-child(2) { width: 340px; height: 340px; left: -80px; bottom: -60px; background: rgba(255,176,32,.28); animation-duration: 22s; }
  .aurora i:nth-child(3) { width: 260px; height: 260px; right: 38%; bottom: -40px; background: rgba(31,122,77,.2); animation-duration: 26s; }
  @keyframes drift { to { transform: translate3d(60px, 40px, 0) scale(1.1); } }
  .hero-in { max-width: 1120px; margin: 0 auto; padding: 4.5rem 3rem 5rem; display: grid; grid-template-columns: 1.05fr 1fr; gap: 3rem; align-items: center; }
  .pill { display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.4rem 0.9rem; border-radius: 999px; background: #fff; border: 1px solid var(--border); font-size: 0.82rem; font-weight: 600; color: var(--accent); margin-bottom: 1.4rem; }
  .pill .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent-light); animation: pulse 1.8s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.4; transform: scale(0.8); } }
  .hero h1 { font-size: clamp(2.6rem, 5.4vw, 4.4rem); line-height: 1.03; margin-bottom: 1.1rem; }
  .hero-sub { font-size: 1.12rem; line-height: 1.65; color: var(--ink-muted); max-width: 33rem; margin-bottom: 1.8rem; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; align-items: center; }
  .hero-note { margin-top: 1rem; font-size: 0.86rem; color: var(--ink-muted); }
  .hero-stage { position: relative; min-height: 470px; display: flex; align-items: center; justify-content: center; }
  .book-wrap { position: relative; z-index: 2; animation: float 7s ease-in-out infinite; }
  .book-wrap img { display: block; width: min(300px, 62vw); height: auto; border-radius: 6px; filter: drop-shadow(0 34px 44px rgba(15,42,30,.35)); transform: rotate(4deg); }
  @keyframes float { 50% { translate: 0 -16px; rotate: -0.6deg; } }
  .glass { position: absolute; z-index: 3; background: rgba(255,255,255,.72); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,.9); border-radius: 18px; box-shadow: var(--shadow-lg); padding: 0.85rem 1.1rem; }
  .glass b { display: block; font-family: var(--serif); font-size: 1.7rem; font-weight: 800; line-height: 1; color: var(--accent); }
  .glass span { font-size: 0.8rem; color: var(--ink-muted); }
  .glass.g1 { left: -4%; top: 40px; animation: float 8s ease-in-out -2s infinite; }
  .glass.g2 { right: -4%; top: 150px; animation: float 9s ease-in-out -4s infinite; }
  .glass.g3 { left: 4%; bottom: 30px; animation: float 7.5s ease-in-out -1s infinite; }
  .glass.g3 b { color: #C47F00; }

  /* STATS */
  .stats { background: #fff; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .stats-in { max-width: 1120px; margin: 0 auto; padding: 1.8rem 3rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .stat b { display: block; font-family: var(--serif); font-size: 2rem; font-weight: 800; color: var(--ink); line-height: 1.1; }
  .stat span { font-size: 0.9rem; color: var(--ink-muted); }

  /* INSIDE */
  .cards4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .card { background: #fff; border: 1px solid var(--border); border-radius: 20px; padding: 1.6rem; box-shadow: var(--shadow-sm); transition: transform 0.25s, box-shadow 0.25s; }
  .card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .card .ic { width: 46px; height: 46px; border-radius: 14px; background: var(--bg-card); color: var(--accent); display: grid; place-items: center; margin-bottom: 1rem; }
  .card .ic svg { width: 24px; height: 24px; }
  .card h3 { font-size: 1.12rem; margin-bottom: 0.4rem; line-height: 1.25; }
  .card p { font-size: 0.93rem; color: var(--ink-muted); line-height: 1.6; }

  /* AUTHOR */
  .author { display: grid; grid-template-columns: 220px 1fr; gap: 2.5rem; align-items: center; }
  .author img { width: 220px; height: 220px; object-fit: cover; border-radius: 28px; box-shadow: var(--shadow-lg); }
  .author p { font-size: 1.05rem; color: var(--ink-muted); margin-bottom: 1rem; max-width: 40rem; }

  /* GIFTS */
  .gifts { background: #0F2A1E; color: #F1FAF4; position: relative; overflow: hidden; isolation: isolate; }
  .gifts::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(50% 80% at 100% 0%, rgba(91,214,160,.28), transparent 70%), radial-gradient(40% 60% at 0% 100%, rgba(255,176,32,.16), transparent 70%); }
  .gifts-in { max-width: 1120px; margin: 0 auto; padding: 4.5rem 3rem; }
  .gifts h2 { color: #F1FAF4; }
  .gifts h2 em { color: #5BD6A0; }
  .gifts .block-tag { color: #8FE5BF; }
  .gift-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-top: 2rem; }
  .gift { border: 1px solid rgba(143,229,191,.35); background: rgba(241,250,244,.06); border-radius: 22px; padding: 1.8rem; animation: breathe 6s ease-in-out infinite; }
  .gift:nth-child(2) { animation-delay: -3s; }
  @keyframes breathe { 50% { translate: 0 -8px; } }
  .gift .num { font-family: var(--serif); font-size: 3rem; font-weight: 800; line-height: 1; color: #5BD6A0; }
  .gift h3 { font-size: 1.25rem; margin: 0.4rem 0; color: #fff; }
  .gift p { color: rgba(241,250,244,.78); font-size: 0.97rem; }
  .gifts-cta { margin-top: 2rem; }

  /* NEXT STEPS */
  .cards3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .step { display: flex; flex-direction: column; gap: 0.5rem; text-decoration: none; color: inherit; }
  .step .tag { font-size: 0.74rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); font-weight: 600; }
  .step h3 { font-size: 1.3rem; line-height: 1.2; }
  .step .more { margin-top: auto; padding-top: 0.6rem; color: var(--accent); font-weight: 600; font-size: 0.92rem; }

  /* POSTS & PROJECTS */
  .post-card { display: flex; flex-direction: column; gap: 0.5rem; text-decoration: none; color: inherit; }
  .post-card .tag { font-size: 0.74rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); font-weight: 600; }
  .post-card h3 { font-size: 1.15rem; line-height: 1.25; }
  .post-card p { font-size: 0.93rem; color: var(--ink-muted); line-height: 1.6; }
  .post-card .date { margin-top: auto; font-size: 0.82rem; color: var(--ink-muted); }
  .cards4 .proj h3 { font-size: 1.2rem; }

  /* FAQ */
  .faq-list { max-width: 760px; }
  .faq-item { border-bottom: 1px solid var(--border); padding: 1.1rem 0; }
  .faq-item summary { cursor: pointer; font-family: var(--serif); font-weight: 700; font-size: 1.08rem; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--accent); font-size: 1.4rem; line-height: 1; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { margin-top: 0.7rem; color: var(--ink-muted); }

  /* FINAL CTA */
  .final { background: var(--grad); color: #fff; border-radius: 28px; padding: 3rem 2rem; text-align: center; margin: 1rem 0 4.5rem; position: relative; overflow: hidden; }
  .final h2 { color: #fff; margin-bottom: 0.6rem; }
  .final p { color: rgba(255,255,255,.88); margin-bottom: 1.4rem; }
  .final .btn { background: #fff; border-color: #fff; color: var(--accent); }
  .final .btn:hover { background: var(--ink); border-color: var(--ink); color: #fff; }

  @media (max-width: 1000px) {
    .hero-in { grid-template-columns: 1fr; padding-top: 3rem; }
    .cards4 { grid-template-columns: repeat(2, 1fr); }
    .stats-in { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .hero-in { padding: 2.5rem 1.25rem 3rem; }
    .hero-stage { min-height: 400px; }
    .glass.g1 { left: -2%; top: 10px; }
    .glass.g2 { right: -2%; top: 120px; }
    .glass.g3 { left: 0; bottom: 10px; }
    .stats-in, .gifts-in { padding-left: 1.25rem; padding-right: 1.25rem; }
    .cards4, .cards3, .gift-grid { grid-template-columns: 1fr; }
    .author { grid-template-columns: 1fr; }
    .final { padding: 2.2rem 1.25rem; }
  }
</style>

<!-- HERO: the book is the centre -->
<section class="hero">
  <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="hero-in">
    <div>
      <span class="pill"><span class="dot"></span>Книга · 2-е издание · 2026</span>
      <h1>Как привлечь <em>денежный грант</em></h1>
      <p class="hero-sub">Практическое руководство автора с 18-летним опытом: методология «3 Дерева»®, шаблоны, ИИ-промпты и каталог из более чем 120 источников финансирования. Для бизнеса, стартапов и НКО Центральной Азии.</p>
      <div class="hero-cta">
        <a data-track="guide_hero" href="https://t.me/connect4faq/137" class="btn btn-accent" target="_blank" rel="noopener">Бесплатный путеводитель →</a>
        <a data-track="book_hero" href="/book" class="btn">Заказать книгу · 1 900 сом</a>
      </div>
      <p class="hero-note">Путеводитель по грантам и чек-лист — бесплатно, на русском и кыргызском.</p>
    </div>
    <div class="hero-stage">
      <div class="glass g1"><b>232</b><span>страницы практики</span></div>
      <div class="book-wrap"><img src="/book-cover.png" alt="Книга «Как привлечь денежный грант в бизнес, стартап или проект», 2-е издание" width="300" height="420" fetchpriority="high" /></div>
      <div class="glass g2"><b>120+</b><span>источников в каталоге книги</span></div>
      <div class="glass g3"><b>2 подарка</b><span>к каждой книге</span></div>
    </div>
  </div>
</section>

<!-- TRUST -->
<div class="stats">
  <div class="stats-in">
    <div class="stat"><b>18+ лет</b><span>опыта в фандрайзинге</span></div>
    <div class="stat"><b>$2.3 млн</b><span>привлечено финансирования</span></div>
    <div class="stat"><b>800+</b><span>экземпляров 1-го издания</span></div>
    <div class="stat"><b>4 страны</b><span>ЦА, где книгу читают</span></div>
  </div>
</div>

<div class="wrap">

  <!-- INSIDE -->
  <section class="block reveal">
    <div class="block-head">
      <div class="block-head-left">
        <span class="block-tag">Что внутри</span>
        <h2 class="block-title">Всё, чтобы подать <em>сильную заявку</em></h2>
      </div>
      <a href="/book" class="all-link">О книге →</a>
    </div>
    <div class="cards4">
      <div class="card">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21v-8"/><path d="M12 13c-3.5 0-6-2.5-6-6 3.5 0 6 2.5 6 6z"/><path d="M12 13c3.5 0 6-2.5 6-6-3.5 0-6 2.5-6 6z"/></svg></div>
        <h3>Методология «3 Дерева»®</h3>
        <p>Деревья проблем, целей и действий: как превратить идею в понятный проект.</p>
      </div>
      <div class="card">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l2 2 4-4"/><rect x="4" y="4" width="16" height="16" rx="3"/></svg></div>
        <h3>Проектирование по шагам</h3>
        <p>От обоснования проблемы до бюджета, рисков и устойчивости. Чек-листы и шаблоны.</p>
      </div>
      <div class="card">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 4.6L18 9l-4.2 1.4L12 15l-1.8-4.6L6 9l4.2-1.4z"/><path d="M18 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg></div>
        <h3>ИИ для фандрайзинга</h3>
        <p>Инструменты и готовые промпты для проекта и бизнес-плана.</p>
      </div>
      <div class="card">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></div>
        <h3>Где искать финансирование</h3>
        <p>Более 120 источников: международные фонды, инвесторы, льготные программы и возможности для Кыргызстана.</p>
      </div>
    </div>
  </section>

  <!-- AUTHOR -->
  <section class="block reveal" style="padding-top:0">
    <div class="author">
      <img src="/book-photos/author.webp" alt="Азат Исраилов, автор книги" width="220" height="220" loading="lazy" />
      <div>
        <span class="block-tag">Об авторе</span>
        <h2 class="block-title" style="margin:0.3rem 0 1rem">Азат <em>Исраилов</em></h2>
        <p>Консультант и тренер по фандрайзингу. Работаю с 2008 года, помогаю предпринимателям, НКО и консультантам Центральной Азии пройти путь от идеи до результата: проект — финансирование — реализация.</p>
        <a href="/about" class="all-link">Подробнее об авторе →</a>
      </div>
    </div>
  </section>
</div>

<!-- GIFTS -->
<section class="gifts">
  <div class="gifts-in">
    <span class="block-tag">Подарки к книге</span>
    <h2 class="block-title" style="margin-top:0.3rem">Два бонуса <em>каждому читателю</em></h2>
    <div class="gift-grid">
      <div class="gift">
        <div class="num">5</div>
        <h3>возможностей финансирования</h3>
        <p>ИИ на Fundan подберёт пять вариантов под вашу задачу. Платить не нужно: достаточно скрина чека за книгу.</p>
      </div>
      <div class="gift">
        <div class="num">1</div>
        <h3>проект с ИИ-помощником</h3>
        <p>Разработайте проект от идеи до проектной заявки с помощью ИИ-помощника.</p>
      </div>
    </div>
    <div class="gifts-cta"><a data-track="gifts_cta" href="/book#gift" class="btn btn-accent">Как получить подарки →</a></div>
  </div>
</section>

<div class="wrap">

  <!-- NEXT STEPS -->
  <section class="block reveal">
    <div class="block-head">
      <div class="block-head-left">
        <span class="block-tag">Что дальше</span>
        <h2 class="block-title">Углубиться: <em>курс, тренинги, ИИ</em></h2>
      </div>
    </div>
    <div class="cards3">
      <a href="/courses" class="card step">
        <span class="tag">Курс</span>
        <h3>Фандрайзинг с нуля до гранта</h3>
        <p>Полная система поиска и привлечения финансирования: от психологии доноров до выигрышной заявки.</p>
        <span class="more">Смотреть курс →</span>
      </a>
      <a href="/trainings" class="card step">
        <span class="tag">Тренинги</span>
