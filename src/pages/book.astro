<dialog class="lb" id="lb"><button aria-label="Закрыть">×</button><img alt="" /></dialog>

<script>
  document.querySelectorAll<HTMLButtonElement>('.vid').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.yt;
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.title = btn.getAttribute('aria-label') || 'Видео';
      btn.replaceChildren(f);
    }, { once: true });
  });

  const lb = document.getElementById('lb') as HTMLDialogElement;
  const lbImg = lb.querySelector('img') as HTMLImageElement;
  document.querySelectorAll<HTMLElement>('[data-zoom]').forEach(el => {
    el.addEventListener('click', () => {
      lbImg.src = el.dataset.zoom!;
      lb.showModal();
    });
  });
  lb.addEventListener('click', () => lb.close());

  const sbar = document.getElementById('sbar')!;
  const hero = document.getElementById('top')!;
  const final = document.getElementById('final')!;
  let heroOut = false, finalIn = false;
  const sync = () => {
    const on = heroOut && !finalIn;
    sbar.classList.toggle('on', on);
    sbar.setAttribute('aria-hidden', String(!on));
    sbar.querySelector('a')!.tabIndex = on ? 0 : -1;
  };
  new IntersectionObserver(([e]) => { heroOut = !e.isIntersecting; sync(); }).observe(hero);
  new IntersectionObserver(([e]) => { finalIn = e.isIntersecting; sync(); }).observe(final);
</script>
