---
import Base from '../layouts/Base.astro';

const ORDER = 'https://forms.gle/H7iPyB8r7xd6uHg67';
const GUIDE = 'https://t.me/connect4faq/137';
const CHECKLIST = 'https://t.me/connect4faq/78';
const FUNDAN = 'https://fundan.cc';
const WHATSAPP = 'https://wa.me/996702271827';

const videos = [
  { id: 'eLf2Wqho2HE', title: 'Грант на бизнес или проект: книга, которая реально помогает' },
  { id: 'sXQdC-QivQY', title: 'Показываю содержание книги «Как привлечь денежный грант в бизнес, стартап или проект»' },
];

const contents = [
  ['Основы грантов и финансирования', 'Как работают гранты, инвестиции, конкурсы и программы поддержки — простым языком.'],
  ['30+ вопросов и ответов', 'Самые частые вопросы предпринимателей и НКО о грантах — с развёрнутыми ответами.'],
  ['Поиск и анализ конкурсов', 'Как читать требования доноров и выбирать возможности, на которые стоит подаваться.'],
  ['Разработка сильных проектов', 'Пошагово: проблема, цели, задачи и ожидаемые результаты.'],
  ['Методология «3 Дерева»®', 'Авторская логическая модель для качественной проектной заявки.'],
  ['Подготовка бюджета', 'Как считать расходы и обосновывать бюджет так, чтобы ему верили.'],
  ['Типичные ошибки заявителей', 'Частые причины отказов и способы их избежать.'],
  ['Гранты для бизнеса и стартапов', 'Особенности заявок для предпринимателей и коммерческих проектов.'],
  ['ИИ для фандрайзинга', 'Практические инструкции и готовые промпты для работы с ChatGPT и другими ИИ-инструментами.'],
  ['Шаблоны, чек-листы, примеры', 'Образцы документов и заготовки, которые можно взять в работу сразу.'],
  ['Практические кейсы', 'Два разобранных проекта: социальный и бизнес — с логикой и структурой.'],
  ['Каталог источников финансирования', '47 грантодателей для Кыргызстана и ЦА, инвестиционные фонды, льготное финансирование, платформы и организации поддержки.'],
];

const reviews = [
  {
    name: 'Гульмира Саматова',
    role: 'консультант, тренер, основательница лавандовой экофермы',
    metric: '4 млн сом',
    metricLabel: 'бизнес-грантов с 2022 года',
    short: 'С помощью этой книги я, сельская учительница, привлекла более 4 млн сомов грантов и обучила 580 студентов — 80% из них открыли свои бизнесы.',
    full: 'Я познакомилась с книгой Азата Исраилова в 2021 году и пользуюсь ею до сих пор. С её помощью с 2022 года я привлекла более 4 млн сомов бизнес-грантов от Shestarts, ARIS, ACTED, FSDS, Министерства экономики КР и Кыргызпатента. Книга помогла мне, сельской учительнице, выйти в мир бизнеса, открыть авторский курс — обучить более 580 студентов, 80% из которых основали свои бизнесы. А ещё благодаря ей я основала первую на юге Кыргызстана лавандовую экоферму.',
  },
  {
    name: 'Чолпон Шабдыраева',
    role: 'предпринимательница, тренер, консультант',
    metric: '98 млн сом',
    metricLabel: 'инвестиций для клиентов',
    short: 'Книга стала поворотом — благодаря её методам мои клиенты привлекли около 98 миллионов сомов инвестиций.',
    full: 'Книга Азата Исраилова стала поворотом в моём профессиональном пути. В ней не сухая теория, а конкретные кейсы, которые можно применять сразу. Благодаря этому опыту я сопровождаю предпринимателей, готовлю презентации и провожу консультации — удалось привлечь около 98 миллионов сомов инвестиций. Сама зарабатываю на тренерстве и консалтинге до 150 000 сом в месяц. Тем, кто хочет развивать дело, получать гранты и идти к финансовой независимости — рекомендую как незаменимый ориентир.',
  },
  {
    name: 'Аззамбек Жээнбай уулу',
    role: 'исполнительный директор бизнес-ассоциации ЖИА',
    metric: '',
    metricLabel: '',
    short: 'Одно из самых полезных практических руководств по грантам — инструменты подходят и начинающим, и опытным.',
    full: 'Считаю это руководство одним из самых полезных практических материалов по привлечению грантов. Автор собрал многолетний опыт в простой и понятной форме — инструменты подойдут как начинающим, так и опытным. Особую ценность придают методология «3 Дерева» и практическая информация об источниках финансирования. Уверен, книга будет полезна предпринимателям, стартапам, НКО, образовательным учреждениям и всем, кто хочет научиться писать проекты.',
  },
  {
    name: 'Анара Кадырбаева',
    role: 'наставник, консультант, общественный деятель',
    metric: '',
    metricLabel: '',
    short: 'Автор щедро делится тем опытом, что обычно приходит лишь с годами. Он делает это просто и по-человечески.',
    full: 'Эта книга Азата Исраилова не только о грантах и финансировании проекта. Она о человеке, который не боится браться за дело и доводить замысел до результата. Автор щедро делится тем опытом, что обычно приходит лишь с годами. Он делает это просто и по-человечески. Рекомендую каждому, кто хочет, чтобы его идея нашла опору и воплотилась в жизнь.',
  },
];

const faq = [
  { q: 'Сколько стоит книга «Как привлечь денежный грант»?', a: 'Печатное издание (2-е переработанное и дополненное, 232 страницы) стоит 1 900 сом. Для организаций и групповых заказов от 10 экземпляров действуют скидки.' },
  { q: 'Где купить книгу?', a: 'Заказать можно на этой странице через форму — доставка по всем регионам Кыргызстана. Также книга есть в книжных магазинах Бишкека: «Раритет», «Bookingem», «Китеп Ал»; небольшая партия — в Оше.' },
  { q: 'Что за подарок от Fundan для покупателей книги?', a: 'Это возможность увидеть, какое финансирование доступно именно вам. Покупатели книги получают на fundan.cc бесплатный подбор 5 возможностей под свой проект (обычная цена — 200 сом): ИИ объясняет, почему каждая подходит, и подсказывает, с чего начать. Нужно отправить чек об оплате книги в Telegram-бот @c4faq_bot и описать свою задачу.' },
  { q: 'Какие источники финансирования есть в каталоге книги?', a: 'В конце книги — каталог источников для Кыргызстана и Центральной Азии: 47 грантодателей, а также инвестиционные фонды и акселераторы, источники льготного финансирования, платформы по грантам и инвестициям, благотворительные фонды и организации поддержки бизнеса.' },
  { q: 'Для кого подходит руководство?', a: 'Для предпринимателей и стартапов, НКО и организаций, консультантов и тренеров, которые ищут финансирование или хотят научиться писать сильные проектные заявки.' },
  { q: 'Что такое методология «3 Дерева»®?', a: 'Авторская логическая модель Азата Исраилова для разработки проектов и заявок: дерево проблем, дерево целей и дерево действий. Помогает выстроить связь между проблемой, действиями и результатом, которую ищет донор.' },
  { q: 'Можно ли сначала посмотреть материалы бесплатно?', a: 'Да. На основе книги подготовлены бесплатный путеводитель по грантам и чек-лист с ответами на частые вопросы на русском и кыргызском языках — ссылки на этой странице.' },
  { q: 'Как стать партнёром по продаже книги?', a: 'Открыт к партнёрству с книжными магазинами, образовательными и бизнес-организациями, ассоциациями, банками, фондами и частными реселлерами. Партнёр получает комиссию с продаж и скидки на оптовые заказы (от 10 экземпляров), а я помогаю с продвижением и продажами среди вашей аудитории. Размер комиссии и скидок зависит от тиража и формата сотрудничества — обсуждаем индивидуально. Возможно и издание книги на другом языке под вашу аудиторию или страну при минимальном тираже от 100 экземпляров. Напишите в WhatsApp +996 702 27 18 27 — предложите формат, и мы обсудим условия.' },
  { q: 'Есть ли электронная версия и книга на кыргызском?', a: 'На электронную версию действуют скидки — условия уточняйте у автора в WhatsApp. Публикация книги на кыргызском языке планируется в следующем году.' },
];

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const bookLd = {
  '@type': 'Book',
  name: 'Как привлечь денежный грант в бизнес или проект',
  bookEdition: '2-е издание',
  datePublished: '2026',
  inLanguage: 'ru',
  numberOfPages: 232,
  image: ['https://azatisrail.org/book-cover.png', 'https://azatisrail.org/book-photos/cover-front.webp'],
  url: 'https://azatisrail.org/book/',
  author: { '@id': 'https://azatisrail.org/#person' },
  about: ['Фандрайзинг', 'Гранты', 'Методология «3 Дерева»'],
  offers: { '@type': 'Offer', price: '1900', priceCurrency: 'KGS', availability: 'https://schema.org/InStock', url: 'https://azatisrail.org/book/' },
};
---
<Base
  title="Как привлечь денежный грант — Руководство Азата Исраилова"
  description="2-е издание руководства по фандрайзингу: методология «3 Дерева»®, гранты для бизнеса и НКО, ИИ-инструменты, каталог из 47 грантодателей. 1 900 сом и подарок — 5 возможностей финансирования на Fundan бесплатно."
  type="book"
  image="/book-cover.png"
  jsonLd={[bookLd, faqLd]}
>
<style>
  .bk-wrap { max-width: 1120px; margin: 0 auto; padding: 0 3rem; }
  .bk-tag { font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); display: block; margin-bottom: 0.9rem; font-weight: 500; }
  .bk-title { font-family: var(--serif); font-size: clamp(2rem, 3.6vw, 3rem); font-weight: 500; line-height: 1.08; letter-spacing: -0.01em; margin-bottom: 2.75rem; }
  .bk-title em { font-style: italic; color: var(--accent); }
  .bk-section { padding: 6rem 0; }
  .bk-icon { width: 1.15em; height: 1.15em; flex-shrink: 0; }

  /* HERO */
  .hero { position: relative; background: #120E0B; color: #F6F1E9; overflow: hidden; isolation: isolate; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(60% 80% at 78% 40%, rgba(192,136,88,0.30), transparent 70%), radial-gradient(40% 50% at 8% 100%, rgba(122,79,42,0.35), transparent 70%); }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; opacity: 0.5; background-image: linear-gradient(rgba(246,241,233,0.04) 1px, transparent 1px); background-size: 100% 6px; mix-blend-mode: overlay; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 4rem; align-items: center; padding: 5.5rem 0 4.5rem; }
  .hero-eyebrow { display: inline-flex; align-items: center; gap: 0.8rem; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent-light); margin-bottom: 1.6rem; }
  .hero-eyebrow::before { content: ''; width: 2.2rem; height: 1px; background: var(--accent-light); }
  .hero h1 { font-family: var(--serif); font-size: clamp(2.8rem, 5.4vw, 4.9rem); font-weight: 500; line-height: 0.98; letter-spacing: -0.02em; margin-bottom: 1.6rem; color: #FBF6EC; }
  .hero h1 em { font-style: italic; color: var(--accent-light); display: block; }
  .hero-sub { font-size: 1.02rem; line-height: 1.8; color: rgba(246,241,233,0.72); max-width: 30rem; margin-bottom: 2.2rem; }
  .hero-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1.1rem 1.6rem; margin-bottom: 2rem; }
  .btn-gold { display: inline-flex; align-items: center; gap: 0.6rem; background: linear-gradient(135deg, #D9A86F, #B97C45); color: #18130F; padding: 1.05rem 2rem; font-size: 0.84rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 10px 28px -10px rgba(192,136,88,0.7); }
  .btn-gold:hover { transform: translateY(-2px); box-shadow: 0 16px 34px -10px rgba(192,136,88,0.85); }
  .btn-gold small { font-family: var(--serif); font-size: 1.05rem; letter-spacing: 0; text-transform: none; font-weight: 600; opacity: 0.85; }
  .link-light { color: rgba(246,241,233,0.78); font-size: 0.86rem; text-decoration: none; border-bottom: 1px solid rgba(246,241,233,0.25); padding-bottom: 2px; transition: color 0.2s, border-color 0.2s; }
  .link-light:hover { color: #fff; border-color: var(--accent-light); }
  .hero-gift { display: flex; align-items: center; gap: 0.9rem; max-width: 32rem; padding: 1.05rem 1.3rem; border: 1px solid rgba(217,168,111,0.7); background: linear-gradient(90deg, rgba(217,168,111,0.24), rgba(217,168,111,0.06)); box-shadow: 0 18px 40px -20px rgba(217,168,111,0.6); text-decoration: none; color: #F6F1E9; transition: border-color 0.2s, background 0.2s; }
  .hero-gift:hover { border-color: var(--accent-light); background: rgba(217,168,111,0.18); }
  .hero-gift .bk-icon { color: var(--accent-light); width: 1.6rem; height: 1.6rem; }
  .hero-gift b { color: #F0CB98; font-weight: 500; }
  .hero-gift span { font-size: 0.84rem; line-height: 1.55; color: rgba(246,241,233,0.85); }
  .hero-photo { position: relative; padding: 0 0 1.6rem 1.6rem; }
  .hero-photo::before { content: ''; position: absolute; inset: 1.6rem 1.6rem 0 0; border: 1px solid rgba(217,168,111,0.55); z-index: 0; }
  .hero-photo img { position: relative; z-index: 1; display: block; width: 100%; height: auto; box-shadow: 0 40px 70px -25px rgba(0,0,0,0.75); }
  .hero-badge { position: absolute; z-index: 2; left: 0; bottom: 0; background: #F6F1E9; color: #18130F; padding: 0.8rem 1.15rem; box-shadow: 0 14px 30px -12px rgba(0,0,0,0.6); }
  .hero-badge b { display: block; font-family: var(--serif); font-size: 1.7rem; font-weight: 600; line-height: 1; color: var(--accent); }
  .hero-badge span { font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-muted); }
  .hero-stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid rgba(246,241,233,0.14); }
  .hstat { padding: 1.8rem 1.4rem 2rem 0; }
  .hstat + .hstat { padding-left: 1.6rem; border-left: 1px solid rgba(246,241,233,0.14); }
  .hstat b { display: block; font-family: var(--serif); font-size: 2.5rem; font-weight: 500; color: #FBF6EC; line-height: 1; }
  .hstat span { display: block; margin-top: 0.45rem; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(246,241,233,0.55); }

  /* GIFT BAND */
  .gband { display: block; background: linear-gradient(100deg, #E4B77C, #C58B52 55%, #D9A86F); color: #18130F; text-decoration: none; transition: filter 0.2s; }
  .gband:hover { filter: brightness(1.06); }
  .gband-in { display: flex; align-items: center; gap: 1rem; padding-top: 1.1rem; padding-bottom: 1.1rem; }
  .gband .bk-icon { width: 1.7rem; height: 1.7rem; }
  .gband-t { flex: 1; font-size: 0.95rem; line-height: 1.5; }
  .gband-t b { font-weight: 600; }
  .gband-b { flex-shrink: 0; font-size: 0.78rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; border-bottom: 1px solid rgba(24,19,15,0.5); padding-bottom: 2px; }

  /* VIDEO */
  .video-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .vid { display: block; width: 100%; padding: 0; border: 0; background: #000; cursor: pointer; position: relative; aspect-ratio: 16 / 9; overflow: hidden; }
  .vid img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s, opacity 0.3s; opacity: 0.88; }
  .vid:hover img { transform: scale(1.04); opacity: 1; }
  .vid-play { position: absolute; left: 50%; top: 50%; width: 4.4rem; height: 4.4rem; margin: -2.2rem 0 0 -2.2rem; border-radius: 50%; background: rgba(253,250,245,0.92); display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 30px -8px rgba(0,0,0,0.6); transition: transform 0.2s; }
  .vid:hover .vid-play { transform: scale(1.08); }
  .vid-play::after { content: ''; margin-left: 5px; border-left: 15px solid var(--accent); border-top: 10px solid transparent; border-bottom: 10px solid transparent; }
  .vid iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .vid-cap { margin-top: 0.9rem; font-family: var(--serif); font-size: 1.15rem; line-height: 1.3; color: var(--ink); }

  /* CONTENTS */
  .contents { background: var(--bg-card); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .contents-grid { display: grid; grid-template-columns: 340px 1fr; gap: 4.5rem; align-items: start; }
  .contents-photo { position: sticky; top: 90px; }
  .contents-photo button { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .contents-photo img { display: block; width: 100%; height: auto; box-shadow: 0 30px 50px -28px rgba(24,19,15,0.5); transform: rotate(-1.6deg); transition: transform 0.3s; border: 8px solid #fff; }
  .contents-photo button:hover img { transform: rotate(0deg) scale(1.02); }
  .contents-photo figcaption { margin-top: 1.2rem; font-size: 0.78rem; color: var(--ink-muted); text-align: center; }
  .clist { list-style: none; display: grid; grid-template-columns: 1fr 1fr; column-gap: 3rem; counter-reset: c; }
  .clist li { counter-increment: c; display: grid; grid-template-columns: 2.6rem 1fr; gap: 0.5rem; padding: 1.35rem 0; border-bottom: 1px solid var(--border); }
  .clist li::before { content: counter(c, decimal-leading-zero); font-family: var(--serif); font-size: 1.5rem; line-height: 1.1; color: var(--accent-light); font-weight: 500; }
  .clist h3 { font-size: 0.95rem; font-weight: 500; line-height: 1.35; margin-bottom: 0.3rem; color: var(--ink); }
  .clist p { font-size: 0.82rem; line-height: 1.65; color: var(--ink-muted); }

  /* GALLERY */
  .gal-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; align-items: start; }
  .gal-grid figure:nth-child(even) { margin-top: 2.5rem; }
  .gal-grid button { display: block; position: relative; width: 100%; padding: 0; border: 0; background: var(--bg-card); cursor: zoom-in; overflow: hidden; aspect-ratio: 3 / 4; }
  .gal-grid img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s; }
  .gal-grid button:hover img { transform: scale(1.05); }
  .gal-grid figcaption { margin-top: 0.8rem; font-size: 0.78rem; color: var(--ink-muted); line-height: 1.5; }

  /* PAGES STRIP */
  .strip-sec { background: #18130F; color: #F6F1E9; }
  .strip-sec .bk-title { color: #FBF6EC; margin-bottom: 0.8rem; }
  .strip-sec .bk-title em, .strip-sec .bk-tag { color: var(--accent-light); }
  .strip-note { font-size: 0.86rem; color: rgba(246,241,233,0.55); margin-bottom: 2.2rem; }
  .strip { display: flex; gap: 1.5rem; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0.5rem 0 1.6rem; scrollbar-width: thin; scrollbar-color: var(--accent) transparent; }
  .strip figure { flex: 0 0 auto; width: 270px; scroll-snap-align: start; }
  .strip figure.wide { width: 370px; }
  .strip button { display: block; width: 100%; padding: 0; border: 0; background: #fff; cursor: zoom-in; box-shadow: 0 24px 40px -22px #000; }
  .strip img { display: block; width: 100%; height: auto; }
