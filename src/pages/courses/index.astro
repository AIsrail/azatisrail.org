---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const courses = await getCollection('courses');
---
<Base title="Курсы">
<style>
  .page-header { padding: 3rem 0 2rem; border-bottom: 1px solid var(--border); }
  .page-title { font-family: var(--serif); font-size: clamp(2rem,4vw,3rem); font-weight: 500; line-height: 1.1; }
  .page-title em { font-style: italic; color: var(--accent); }
  .page-desc { margin-top: 0.75rem; font-size: 0.95rem; color: var(--ink-muted); max-width: 540px; line-height: 1.75; }
  .course-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 0; border: 1px solid var(--border); margin-top: 2rem; margin-bottom: 4rem; }
  .c-card { padding: 2rem; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 0.75rem; transition: background 0.22s; }
  .c-card:nth-child(3n) { border-right: none; }
  .c-card:hover { background: var(--bg-card); }
  .c-badge { display: inline-flex; align-self: flex-start; border: 1px solid var(--border); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 10px; color: var(--ink-muted); background: var(--bg-card); }
  .c-badge.f { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .c-title { font-family: var(--serif); font-size: 1.25rem; font-weight: 500; line-height: 1.3; flex: 1; }
  .c-desc { font-size: 0.86rem; color: var(--ink-muted); line-height: 1.7; }
  .c-meta { display: flex; gap: 1rem; font-size: 0.75rem; color: var(--ink-muted); padding-top: 0.75rem; border-top: 1px solid var(--border); margin-top: auto; align-items: center; flex-wrap: wrap; }
  .c-price { font-family: var(--serif); font-size: 1.15rem; color: var(--ink); font-weight: 500; margin-left: auto; }
  @media(max-width:768px){ .course-grid { grid-template-columns: 1fr; } .c-card { border-right: none; } }
</style>
<div class="wrap">
  <div class="page-header">
    <p class="page-tag">Обучение</p>
    <h1 class="page-title">Онлайн <em>курсы</em></h1>
    <p class="page-desc">Структурированные курсы для самостоятельного изучения с видеоуроками, материалами и сертификатом.</p>
  </div>
  <div class="course-grid">
    {courses.map(c => (
      <a href={c.data.link ?? '#'} class="c-card" target={c.data.link ? '_blank' : undefined}>
        {c.data.badge && <span class={`c-badge ${c.data.isFeatured?'f':''}`}>{c.data.badge}</span>}
        <div class="c-title">{c.data.title}</div>
        <p class="c-desc">{c.data.description}</p>
        <div class="c-meta">
          {c.data.duration && <span>{c.data.duration}</span>}
          {c.data.format && <span>{c.data.format}</span>}
          {c.data.price && <span class="c-price">{c.data.price}</span>}
        </div>
      </a>
    ))}
    {courses.length === 0 && <p style="padding:2rem;color:var(--ink-muted);grid-column:1/-1">Курсы появятся в ближайшее время.</p>}
  </div>
</div>
</Base>
